<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Arvrel.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#0A1117" />
      <Setter Property="Foreground" Value="#DDE8EE" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#111C24" />
      <Setter Property="BorderBrush" Value="#223541" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="Border.subtle">
      <Setter Property="Background" Value="#0D171E" />
      <Setter Property="BorderBrush" Value="#1C303B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2A87A7" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.warning">
      <Setter Property="Background" Value="#6A4720" />
      <Setter Property="Foreground" Value="#FFE4B5" />
    </Style>

    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#F2F7F9" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#86A9B8" />
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#7893A0" />
    </Style>

    <Style Selector="TextBlock.measurement">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#EAF4F7" />
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="MinHeight" Value="5" />
      <Setter Property="Foreground" Value="#44A3C1" />
      <Setter Property="Background" Value="#263740" />
    </Style>
  </Application.Styles>
</Application>
