<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Arvrel.Desktop.Controls"
        xmlns:vm="using:Arvrel.Desktop.ViewModels"
        x:Class="Arvrel.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ARVREL — Virtual Protection Relay Laboratory"
        Width="1480"
        Height="900"
        MinWidth="1180"
        MinHeight="720">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Background="#0D171E"
            BorderBrush="#223541"
            BorderThickness="0,0,0,1"
            Padding="18,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="8" Background="#183C49" BorderBrush="#2D6F83" BorderThickness="1">
            <TextBlock Text="AR" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8ED5E8" />
          </Border>
          <StackPanel Spacing="1">
            <TextBlock Classes="title" Text="{Binding ProductTitle}" />
            <TextBlock Classes="caption" Text="{Binding ProductSubtitle}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="28,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="section" Text="{Binding ShellVersion}" />
          <TextBlock Classes="caption" Text="{Binding PlatformText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding ResetRelayCommand}" Content="RESET RELAY" />
          <Button Classes="primary" Command="{Binding RunCommand}" Content="{Binding RunButtonText}" MinWidth="138" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="350,*,370" Margin="14">
      <Border Grid.Column="0" Classes="card" Margin="0,0,10,0" Padding="10">
        <TabControl>
          <TabItem Header="SOURCE">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10" Margin="4,10,4,4">
                <Border Classes="subtle">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="section" Text="VIRTUAL TEST SET" />
                    <TextBlock FontWeight="Bold" Foreground="#8ED5E8" Text="{Binding ProfileNameText}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="caption" Text="{Binding OutputStateText}" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding InjectionFingerprintText}" />
                    </Grid>
                    <TextBlock Classes="caption" Text="{Binding ProvenanceText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <StackPanel Spacing="5">
                  <TextBlock Classes="section" Text="PRESET" />
                  <ComboBox ItemsSource="{Binding PresetNames}"
                            SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                            MinHeight="34" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Classes="section" Text="FREQUENCY" />
                    <TextBox Text="{Binding FrequencyText, Mode=TwoWay}"
                             HorizontalContentAlignment="Right"
                             MinHeight="34" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="Hz" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                </Grid>

                <Button Classes="primary" Command="{Binding ApplyInjectionCommand}" Content="APPLY CONFIGURED SOURCE" />
                <Button Classes="warning" Command="{Binding FaultCommand}" Content="{Binding FaultButtonText}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" Command="{Binding ClearInjectionCommand}" Content="CLEAR INJECTION" />
                  <Button Grid.Column="1" Command="{Binding SmvCommand}" Content="{Binding SmvButtonText}" />
                </Grid>
                <Button Command="{Binding ResetLaboratoryCommand}" Content="RESET COMPLETE LAB" />

                <Border Classes="subtle">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="section" Text="SOURCE STATUS" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding InjectionEditorStatus}" TextWrapping="Wrap" />
                    <TextBlock Classes="caption" Text="START/STOP retains configured values. Clear injection and relay reset are separate commands." TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Classes="subtle">
                  <StackPanel Spacing="7">
                    <TextBlock Classes="section" Text="PROCESS-BUS CAPABILITY" />
                    <TextBlock FontWeight="SemiBold" Text="LIVE CAPTURE" />
                    <TextBlock Classes="caption" Text="{Binding LiveCaptureStatus}" TextWrapping="Wrap" />
                    <Border Height="1" Background="#223541" />
                    <TextBlock FontWeight="SemiBold" Text="CAPTURE REPLAY" />
                    <TextBlock Classes="caption" Text="{Binding ReplayStatus}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="4I + 4V">
            <Grid RowDefinitions="*,Auto" Margin="4,10,4,4">
              <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="30,54,*,*,68" ColumnSpacing="5" Margin="4,0">
                    <TextBlock Grid.Column="0" Classes="caption" Text="ON" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="SIG" />
                    <TextBlock Grid.Column="2" Classes="caption" Text="RMS" />
                    <TextBlock Grid.Column="3" Classes="caption" Text="ANGLE°" />
                    <TextBlock Grid.Column="4" Classes="caption" Text="SOURCE" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding InjectionChannels}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:InjectionChannelViewModel">
                        <Border Classes="subtle" Margin="0,0,0,5" Padding="7">
                          <Grid ColumnDefinitions="30,54,*,*,68" ColumnSpacing="5">
                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock FontWeight="Bold" Foreground="#8ED5E8" Text="{Binding SignalLabel}" />
                              <TextBlock Classes="caption" Text="{Binding Unit}" />
                            </StackPanel>
                            <TextBox Grid.Column="2" Text="{Binding RmsText, Mode=TwoWay}" HorizontalContentAlignment="Right" />
                            <TextBox Grid.Column="3" Text="{Binding AngleText, Mode=TwoWay}" HorizontalContentAlignment="Right" />
                            <TextBlock Grid.Column="4" Classes="caption" Text="{Binding Provenance}" TextWrapping="Wrap" VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="1" Spacing="7" Margin="0,8,0,0">
                <TextBlock Classes="caption" Text="Unchecked IN/VN are calculated from phase sums. The last valid configured source remains active while an edit is invalid." TextWrapping="Wrap" />
                <Button Classes="primary" Command="{Binding ApplyInjectionCommand}" Content="VALIDATE + APPLY 4I/4V" />
                <TextBlock FontWeight="SemiBold" Text="{Binding InjectionEditorStatus}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="0,0,10,0">
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" Margin="0,0,0,10">
          <Border Grid.Column="0" Classes="card" Margin="0,0,5,0">
            <StackPanel Spacing="4">
              <TextBlock Classes="caption" Text="PHASE A" />
              <TextBlock Classes="measurement" Text="{Binding PhaseAText}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Margin="5,0">
            <StackPanel Spacing="4">
              <TextBlock Classes="caption" Text="PHASE B" />
              <TextBlock Classes="measurement" Text="{Binding PhaseBText}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card" Margin="5,0">
            <StackPanel Spacing="4">
              <TextBlock Classes="caption" Text="PHASE C" />
              <TextBlock Classes="measurement" Text="{Binding PhaseCText}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Classes="card" Margin="5,0,0,0">
            <StackPanel Spacing="4">
              <TextBlock Classes="caption" Text="RESIDUAL" />
              <TextBlock Classes="measurement" Text="{Binding ResidualText}" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="1" Classes="card">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
              <StackPanel Spacing="2">
                <TextBlock Classes="section" Text="TWO-CYCLE WAVEFORM EVIDENCE" />
                <TextBlock Classes="caption" Text="Phase A · Phase B · Phase C · residual · quarter-cycle time ticks" />
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding FrequencyTextDisplay}" />
                <TextBlock Classes="caption" HorizontalAlignment="Right" Text="{Binding WindowText}" />
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#091116" BorderBrush="#21343E" BorderThickness="1" CornerRadius="6" Padding="4">
              <controls:WaveformScope Waveform="{Binding Waveform}" MinHeight="350" />
            </Border>
          </Grid>
        </Border>

        <Border Grid.Row="2" Classes="card" Margin="0,10,0,0">
          <Grid ColumnDefinitions="220,*">
            <StackPanel Grid.Column="0" Spacing="3">
              <TextBlock Classes="section" Text="RELAY STATE" />
              <TextBlock FontSize="16" FontWeight="Bold" Foreground="#9AD8E8" Text="{Binding TripStateText}" TextWrapping="Wrap" />
              <TextBlock Classes="caption" Text="{Binding SettingsGroupText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="3">
              <TextBlock Classes="section" Text="STATUS" />
              <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
              <TextBlock Classes="caption" Text="{Binding TrustStateText}" TextWrapping="Wrap" />
              <TextBlock Classes="caption" Text="{Binding DecisionReason}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Column="2" Classes="card" Padding="10">
        <TabControl>
          <TabItem Header="RELAY">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10" Margin="4,10,4,4">
                <Border Classes="subtle">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Classes="section" Text="ACTIVE SETTING GROUP" />
                        <TextBlock FontWeight="Bold" Foreground="#8ED5E8" Text="{Binding SettingsGroupText}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding SettingsFingerprintText}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,90" ColumnSpacing="8">
                      <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Classes="caption" Text="GROUP NAME" />
                        <TextBox Text="{Binding SettingsEditor.GroupName, Mode=TwoWay}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Classes="caption" Text="REVISION" />
                        <TextBox Text="{Binding SettingsEditor.RevisionText, Mode=TwoWay}" HorizontalContentAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="subtle">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0" FontWeight="Bold" Foreground="#8ED5E8" Text="50P" />
                      <TextBlock Grid.Column="1" Margin="8,0" Classes="caption" Text="PHASE INSTANTANEOUS" />
                      <CheckBox Grid.Column="2" Content="ENABLED" IsChecked="{Binding SettingsEditor.Phase50.Enabled, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                      <StackPanel Grid.Column="0" Spacing="2"><TextBlock Classes="caption" Text="PICKUP A" /><TextBox Text="{Binding SettingsEditor.Phase50.PickupText, Mode=TwoWay}" /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2"><TextBlock Classes="caption" Text="DELAY ms" /><TextBox Text="{Binding SettingsEditor.Phase50.DelayMsText, Mode=TwoWay}" /></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2"><TextBlock Classes="caption" Text="DROPOUT" /><TextBox Text="{Binding SettingsEditor.Phase50.DropoutText, Mode=TwoWay}" /></StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="subtle">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0" FontWeight="Bold" Foreground="#8ED5E8" Text="51P" />
                      <TextBlock Grid.Column="1" Margin="8,0" Classes="caption" Text="PHASE TIME" />
                      <CheckBox Grid.Column="2" Content="ENABLED" IsChecked="{Binding SettingsEditor.Phase51.Enabled, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                      <StackPanel Grid.Column="0" Spacing="2"><TextBlock Classes="caption" Text="PICKUP A" /><TextBox Text="{Binding SettingsEditor.Phase51.PickupText, Mode=TwoWay}" /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2"><TextBlock Classes="caption" Text="CURVE" /><ComboBox ItemsSource="{Binding SettingsEditor.CurveFamilies}" SelectedItem="{Binding SettingsEditor.Phase51.Curve, Mode=TwoWay}" /></StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                      <StackPanel Grid.Column="0" Spacing="2"><TextBlock Classes="caption" Text="TMS" /><TextBox Text="{Binding SettingsEditor.Phase51.MultiplierText, Mode=TwoWay}" /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2"><TextBlock Classes="caption" Text="DEFINITE ms" /><TextBox Text="{Binding SettingsEditor.Phase51.DefiniteDelayMsText, Mode=TwoWay}" /></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2"><TextBlock Classes="caption" Text="MIN OP ms" /><TextBox Text="{Binding SettingsEditor.Phase51.MinimumOperateMsText, Mode=TwoWay}" /></StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                      <StackPanel Grid.Column="0" Spacing="2"><TextBlock Classes="caption" Text="DROPOUT" /><TextBox Text="{Binding SettingsEditor.Phase51.DropoutText, Mode=TwoWay}" /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2"><TextBlock Classes="caption" Text="RESET" /><ComboBox ItemsSource="{Binding SettingsEditor.ResetModes}" SelectedItem="{Binding SettingsEditor.Phase51.ResetMode, Mode=TwoWay}" /></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2"><TextBlock Classes="caption" Text="RESET ms" /><TextBox Text="{Binding SettingsEditor.Phase51.ResetDelayMsText, Mode=TwoWay}" /></StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="subtle">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0" FontWeight="Bold" Foreground="#8ED5E8" Text="50N" />
                      <TextBlock Grid.Column="1" Margin="8,0" Classes="caption" Text="EARTH INSTANTANEOUS" />
                      <CheckBox Grid.Column="2" Content="ENABLED" IsChecked="{Binding SettingsEditor.Earth50.Enabled, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                      <StackPanel Grid.Column="0" Spacing="2"><TextBlock Classes="caption" Text="PICKUP A" /><TextBox Text="{Binding SettingsEditor.Earth50.PickupText, Mode=TwoWay}" /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2"><TextBlock Classes="caption" Text="DELAY ms" /><TextBox Text="{Binding SettingsEditor.Earth50.DelayMsText, Mode=TwoWay}" /></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2"><TextBlock Classes="caption" Text="DROPOUT" /><TextBox Text="{Binding SettingsEditor.Earth50.DropoutText, Mode=TwoWay}" /></StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="subtle">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0" FontWeight="Bold" Foreground="#8ED5E8" Text="51N" />
                      <TextBlock Grid.Column="1" Margin="8,0" Classes="caption" Text="EARTH TIME" />
                      <CheckBox Grid.Column="2" Content="ENABLED" IsChecked="{Binding SettingsEditor.Earth51.Enabled, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                      <StackPanel Grid.Column="0" Spacing="2"><TextBlock Classes="caption" Text="PICKUP A" /><TextBox Text="{Binding SettingsEditor.Earth51.PickupText, Mode=TwoWay}" /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2"><TextBlock Classes="caption" Text="CURVE" /><ComboBox ItemsSource="{Binding SettingsEditor.CurveFamilies}" SelectedItem="{Binding SettingsEditor.Earth51.Curve, Mode=TwoWay}" /></StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                      <StackPanel Grid.Column="0" Spacing="2"><TextBlock Classes="caption" Text="TMS" /><TextBox Text="{Binding SettingsEditor.Earth51.MultiplierText, Mode=TwoWay}" /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2"><TextBlock Classes="caption" Text="DEFINITE ms" /><TextBox Text="{Binding SettingsEditor.Earth51.DefiniteDelayMsText, Mode=TwoWay}" /></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2"><TextBlock Classes="caption" Text="MIN OP ms" /><TextBox Text="{Binding SettingsEditor.Earth51.MinimumOperateMsText, Mode=TwoWay}" /></StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                      <StackPanel Grid.Column="0" Spacing="2"><TextBlock Classes="caption" Text="DROPOUT" /><TextBox Text="{Binding SettingsEditor.Earth51.DropoutText, Mode=TwoWay}" /></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2"><TextBlock Classes="caption" Text="RESET" /><ComboBox ItemsSource="{Binding SettingsEditor.ResetModes}" SelectedItem="{Binding SettingsEditor.Earth51.ResetMode, Mode=TwoWay}" /></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2"><TextBlock Classes="caption" Text="RESET ms" /><TextBox Text="{Binding SettingsEditor.Earth51.ResetDelayMsText, Mode=TwoWay}" /></StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Button Classes="primary" Command="{Binding ApplySettingsCommand}" Content="VALIDATE + APPLY RELAY SETTINGS" />
                <TextBlock FontWeight="SemiBold" Text="{Binding SettingsEditorStatus}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="Applying relay settings resets relay timers/latch but preserves the separately configured source and its run state." TextWrapping="Wrap" />

                <TextBlock Classes="section" Text="PROTECTION ELEMENTS" Margin="0,5,0,0" />
                <ItemsControl ItemsSource="{Binding ProtectionElements}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProtectionElementViewModel">
                      <Border Classes="subtle" Margin="0,0,0,7">
                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" FontWeight="Bold" Foreground="#8ED5E8" Text="{Binding Code}" />
                            <TextBlock Grid.Column="1" Margin="9,0" Classes="caption" Text="{Binding Label}" />
                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding StateText}" />
                          </Grid>
                          <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" />
                          <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="EVENTS">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4,10,4,4">
              <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock FontFamily="Cascadia Mono,Consolas,monospace"
                               FontSize="11"
                               Foreground="#9AB0BA"
                               Text="{Binding}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,7" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </Grid>
</Window>
