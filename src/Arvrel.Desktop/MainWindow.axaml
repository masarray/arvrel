<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Arvrel.Desktop.Controls"
        xmlns:vm="using:Arvrel.Desktop.ViewModels"
        x:Class="Arvrel.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ARVREL — Virtual Protection Relay Laboratory"
        Width="1360"
        Height="820"
        MinWidth="1080"
        MinHeight="680">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Background="#0D171E"
            BorderBrush="#223541"
            BorderThickness="0,0,0,1"
            Padding="18,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="8" Background="#183C49" BorderBrush="#2D6F83" BorderThickness="1">
            <TextBlock Text="AR" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#8ED5E8" />
          </Border>
          <StackPanel Spacing="1">
            <TextBlock Classes="title" Text="{Binding ProductTitle}" />
            <TextBlock Classes="caption" Text="{Binding ProductSubtitle}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="28,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="section" Text="{Binding ShellVersion}" />
          <TextBlock Classes="caption" Text="{Binding PlatformText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding ResetCommand}" Content="RESET" />
          <Button Classes="primary" Command="{Binding RunCommand}" Content="{Binding RunButtonText}" MinWidth="92" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="250,*,310" Margin="14">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="0,0,10,0">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="section" Text="SOURCE" />
              <Border Classes="subtle">
                <StackPanel Spacing="4">
                  <TextBlock FontWeight="Bold" Foreground="#8ED5E8" Text="{Binding SourceModeText}" />
                  <TextBlock Classes="caption" Text="Portable application core" />
                  <TextBlock Classes="caption" Text="{Binding OutputStateText}" />
                </StackPanel>
              </Border>
              <Button Classes="warning" Command="{Binding FaultCommand}" Content="{Binding FaultButtonText}" />
              <Button Command="{Binding SmvCommand}" Content="{Binding SmvButtonText}" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="9">
              <TextBlock Classes="section" Text="CAPABILITIES" />
              <StackPanel Spacing="3">
                <TextBlock FontWeight="SemiBold" Text="LIVE CAPTURE" />
                <TextBlock Classes="caption" Text="{Binding LiveCaptureStatus}" TextWrapping="Wrap" />
              </StackPanel>
              <Border Height="1" Background="#223541" />
              <StackPanel Spacing="3">
                <TextBlock FontWeight="SemiBold" Text="CAPTURE REPLAY" />
                <TextBlock Classes="caption" Text="{Binding ReplayStatus}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="7">
              <TextBlock Classes="section" Text="SOURCE HEALTH" />
              <TextBlock FontWeight="SemiBold" Text="{Binding TrustStateText}" TextWrapping="Wrap" />
              <TextBlock Classes="caption" Text="{Binding DecisionReason}" TextWrapping="Wrap" />
              <TextBlock Classes="caption" Text="{Binding SampleCounterText}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="0,0,10,0">
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" Margin="0,0,0,10">
          <Border Grid.Column="0" Classes="card" Margin="0,0,5,0">
            <StackPanel Spacing="4">
              <TextBlock Classes="caption" Text="PHASE A" />
              <TextBlock Classes="measurement" Text="{Binding PhaseAText}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" Margin="5,0">
            <StackPanel Spacing="4">
              <TextBlock Classes="caption" Text="PHASE B" />
              <TextBlock Classes="measurement" Text="{Binding PhaseBText}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card" Margin="5,0">
            <StackPanel Spacing="4">
              <TextBlock Classes="caption" Text="PHASE C" />
              <TextBlock Classes="measurement" Text="{Binding PhaseCText}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Classes="card" Margin="5,0,0,0">
            <StackPanel Spacing="4">
              <TextBlock Classes="caption" Text="RESIDUAL" />
              <TextBlock Classes="measurement" Text="{Binding ResidualText}" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="1" Classes="card">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
              <StackPanel Spacing="2">
                <TextBlock Classes="section" Text="TWO-CYCLE WAVEFORM EVIDENCE" />
                <TextBlock Classes="caption" Text="Phase A · Phase B · Phase C · residual current" />
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding FrequencyText}" />
                <TextBlock Classes="caption" HorizontalAlignment="Right" Text="{Binding WindowText}" />
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#091116" BorderBrush="#21343E" BorderThickness="1" CornerRadius="6" Padding="4">
              <controls:WaveformScope Waveform="{Binding Waveform}" MinHeight="330" />
            </Border>
          </Grid>
        </Border>

        <Border Grid.Row="2" Classes="card" Margin="0,10,0,0">
          <Grid ColumnDefinitions="Auto,*">
            <StackPanel Grid.Column="0" Width="220" Spacing="3">
              <TextBlock Classes="section" Text="RELAY STATE" />
              <TextBlock FontSize="16" FontWeight="Bold" Foreground="#9AD8E8" Text="{Binding TripStateText}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="3">
              <TextBlock Classes="section" Text="STATUS" />
              <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Column="2" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="card" Margin="0,0,0,10">
          <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="PROTECTION ELEMENTS" />
            <ItemsControl ItemsSource="{Binding ProtectionElements}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProtectionElementViewModel">
                  <Border Classes="subtle" Margin="0,0,0,7">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" FontWeight="Bold" Foreground="#8ED5E8" Text="{Binding Code}" />
                        <TextBlock Grid.Column="1" Margin="9,0" Classes="caption" Text="{Binding Label}" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding StateText}" />
                      </Grid>
                      <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" />
                      <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="card">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Classes="section" Text="EVENTS" Margin="0,0,0,8" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock FontFamily="Cascadia Mono,Consolas,monospace"
                               FontSize="11"
                               Foreground="#9AB0BA"
                               Text="{Binding}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
