<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Arvrel.Desktop</AssemblyName>
    <RootNamespace>Arvrel.Desktop</RootNamespace>
    <AssemblyTitle>ARVREL</AssemblyTitle>
    <Product>ARVREL — Virtual Protection Relay Laboratory</Product>
    <Description>Cross-platform Avalonia desktop shell for the ARVREL virtual protection relay laboratory.</Description>
    <Authors>Ari Sulistiono</Authors>
    <Company>masarray</Company>
    <Copyright>Copyright (C) 2026 Ari Sulistiono</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/masarray/arvrel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">..\..\Asset\icon\favicon.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
    <UseAppHost>true</UseAppHost>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arvrel.Application\Arvrel.Application.csproj" />
    <ProjectReference Include="..\Arvrel.ProcessBus\Arvrel.ProcessBus.csproj" />
    <ProjectReference Include="..\Arvrel.Protection\Arvrel.Protection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\Asset\icon\arvrel_icon.png">
      <Link>Assets\arvrel_icon.png</Link>
    </AvaloniaResource>
  </ItemGroup>
</Project>
