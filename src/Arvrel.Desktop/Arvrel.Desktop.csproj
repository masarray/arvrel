<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Arvrel.Desktop</AssemblyName>
    <RootNamespace>Arvrel.Desktop</RootNamespace>
    <Description>Cross-platform Avalonia desktop shell for the ARVREL virtual protection relay laboratory.</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arvrel.Application\Arvrel.Application.csproj" />
    <ProjectReference Include="..\Arvrel.ProcessBus\Arvrel.ProcessBus.csproj" />
    <ProjectReference Include="..\Arvrel.Protection\Arvrel.Protection.csproj" />
  </ItemGroup>
</Project>
