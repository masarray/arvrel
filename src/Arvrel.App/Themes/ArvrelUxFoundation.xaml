<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ARVREL P0: Precision Industrial Instrument foundation.
         Keep the shell quiet, reserve colour for meaning, and avoid decorative chrome. -->

    <Color x:Key="UxShellColor">#F2F5F7</Color>
    <Color x:Key="UxSurfaceColor">#FFFFFF</Color>
    <Color x:Key="UxSurfaceMutedColor">#F7F9FB</Color>
    <Color x:Key="UxLineColor">#D7E0E7</Color>
    <Color x:Key="UxTextColor">#17212B</Color>
    <Color x:Key="UxMutedColor">#667887</Color>
    <Color x:Key="UxAccentColor">#2E6F9E</Color>
    <Color x:Key="UxAccentSoftColor">#E8F1F7</Color>
    <Color x:Key="UxHealthyColor">#45935A</Color>
    <Color x:Key="UxWarningColor">#BD852B</Color>
    <Color x:Key="UxTripColor">#C44946</Color>
    <Color x:Key="UxInstrumentBayColor">#151D24</Color>
    <Color x:Key="UxInstrumentSurfaceColor">#101820</Color>
    <Color x:Key="UxInstrumentDividerColor">#2A3944</Color>

    <SolidColorBrush x:Key="UxShellBrush" Color="{StaticResource UxShellColor}" />
    <SolidColorBrush x:Key="UxSurfaceBrush" Color="{StaticResource UxSurfaceColor}" />
    <SolidColorBrush x:Key="UxSurfaceMutedBrush" Color="{StaticResource UxSurfaceMutedColor}" />
    <SolidColorBrush x:Key="UxLineBrush" Color="{StaticResource UxLineColor}" />
    <SolidColorBrush x:Key="UxTextBrush" Color="{StaticResource UxTextColor}" />
    <SolidColorBrush x:Key="UxMutedBrush" Color="{StaticResource UxMutedColor}" />
    <SolidColorBrush x:Key="UxAccentBrush" Color="{StaticResource UxAccentColor}" />
    <SolidColorBrush x:Key="UxAccentSoftBrush" Color="{StaticResource UxAccentSoftColor}" />
    <SolidColorBrush x:Key="UxHealthyBrush" Color="{StaticResource UxHealthyColor}" />
    <SolidColorBrush x:Key="UxWarningBrush" Color="{StaticResource UxWarningColor}" />
    <SolidColorBrush x:Key="UxTripBrush" Color="{StaticResource UxTripColor}" />
    <SolidColorBrush x:Key="UxInstrumentBayBrush" Color="{StaticResource UxInstrumentBayColor}" />
    <SolidColorBrush x:Key="UxInstrumentSurfaceBrush" Color="{StaticResource UxInstrumentSurfaceColor}" />
    <SolidColorBrush x:Key="UxInstrumentDividerBrush" Color="{StaticResource UxInstrumentDividerColor}" />

    <Thickness x:Key="UxSpace4">4</Thickness>
    <Thickness x:Key="UxSpace8">8</Thickness>
    <Thickness x:Key="UxSpace12">12</Thickness>
    <Thickness x:Key="UxSpace16">16</Thickness>

    <Style x:Key="UxPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UxSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UxLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="UxSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource UxTextBrush}" />
    </Style>

    <Style x:Key="UxMetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource UxMutedBrush}" />
    </Style>

    <Style x:Key="UxMetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource UxTextBrush}" />
    </Style>

    <Style x:Key="UxQuietButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="112" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{StaticResource UxSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource UxTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UxLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="11.2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" />
                        <Border x:Name="Overlay" Background="Transparent" CornerRadius="5" IsHitTestVisible="False" />
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#A9BBC8" />
                            <Setter TargetName="Overlay" Property="Background" Value="#0F2E6F9E" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="#202E6F9E" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource UxAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UxDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource UxSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UxLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#E5EBF0" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="#F9FBFC" />
        <Setter Property="RowHeight" Value="31" />
        <Setter Property="ColumnHeaderHeight" Value="31" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F5F8FA" />
        <Setter Property="Foreground" Value="{StaticResource UxMutedBrush}" />
        <Setter Property="FontSize" Value="9.8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderBrush" Value="{StaticResource UxLineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="10.3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>