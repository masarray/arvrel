<Window x:Class="Arvrel.App.ProtectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Arvrel.App.Controls"
        Title="ARVREL Relay Settings"
        Width="1040"
        Height="720"
        MinWidth="920"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="116" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        </Style>
        <Style x:Key="SettingCombo" TargetType="ComboBox">
            <Setter Property="Width" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorder}" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <controls:LucideIcon Kind="SlidersHorizontal" Width="18" Height="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Native relay protection settings" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="Settings are entered in secondary amperes. Primary equivalents use the active CT context." Foreground="{StaticResource MutedBrush}" FontSize="10.8" Margin="26,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="HeaderGroupText" Text="GROUP A · REV 1" FontFamily="Cascadia Mono, Consolas" FontSize="11" HorizontalAlignment="Right" />
                    <TextBlock x:Name="HeaderFingerprintText" Text="SETTINGS 000000000000" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="9.4" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="0,10,0,10" x:Name="SettingsTabs">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" /><RowDefinition Height="48" /><RowDefinition Height="48" />
                            <RowDefinition Height="20" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Setting group name" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" x:Name="GroupNameText" Width="220" HorizontalAlignment="Left" TextChanged="GeneralField_Changed" />
                        <TextBlock Grid.Row="1" Text="Revision" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="RevisionText" Style="{StaticResource SettingTextBox}" TextChanged="GeneralField_Changed" />
                        <TextBlock Grid.Row="2" Text="Active CT context" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CtContextText" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                        <Border Grid.Row="4" Grid.ColumnSpan="3" Background="#F7F9FB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="14">
                            <StackPanel>
                                <TextBlock Text="APPLICATION BOUNDARY" Style="{StaticResource SectionLabel}" />
                                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                                           Text="Changing native settings never edits algorithm source. Applying a setting group resets element timers and the virtual trip latch, records an audit event, and reinitializes active live/replay protection state. ARVREL remains virtual-output only." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Phase overcurrent">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.22*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PanelBorder}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="46" /><RowDefinition Height="46" /><RowDefinition Height="46" /><RowDefinition Height="46" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <CheckBox x:Name="Phase50Enabled" Content="50P-1 instantaneous phase overcurrent" FontWeight="SemiBold" IsChecked="True" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed" />
                                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Pickup I&gt;&gt;" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Phase50PickupText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Definite delay" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Phase50DelayText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Dropout ratio" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Phase50DropoutText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Border Grid.Row="4" Background="#F7F9FB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6">
                                    <TextBlock x:Name="Phase50EquivalentText" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <TextBlock Grid.Row="5" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" Text="Pickup is phase segregated. The timer is definite-time and operates only while the selected SMV trust policy allows pickup." />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="42" />
                                    <RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="42" />
                                    <RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="Phase51Enabled" Content="51P time phase overcurrent" FontWeight="SemiBold" IsChecked="True" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed" />
                                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Pickup Is" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Phase51PickupText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Characteristic" Style="{StaticResource FieldLabel}" /><ComboBox Grid.Column="1" x:Name="Phase51CurveCombo" Style="{StaticResource SettingCombo}" SelectionChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="TMS / time dial" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Phase51TmsText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Definite delay" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Phase51DefiniteText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Minimum operate time" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Phase51MinimumText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Dropout ratio" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Phase51DropoutText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="7"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Reset characteristic" Style="{StaticResource FieldLabel}" /><ComboBox Grid.Column="1" x:Name="Phase51ResetCombo" Style="{StaticResource SettingCombo}" SelectionChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Reset time" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Phase51ResetTimeText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="9"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="User curve K / α / C" Style="{StaticResource FieldLabel}" /><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="Phase51KText" Width="68" Margin="0,0,5,0" TextChanged="AnySetting_Changed" /><TextBox x:Name="Phase51AlphaText" Width="68" Margin="0,0,5,0" TextChanged="AnySetting_Changed" /><TextBox x:Name="Phase51CText" Width="68" TextChanged="AnySetting_Changed" /></StackPanel></Grid>
                                <Border Grid.Row="10" Background="#F7F9FB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6">
                                    <TextBlock x:Name="Phase51EquivalentText" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <TextBlock Grid.Row="11" x:Name="Phase51PreviewText" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="10.2" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Earth fault">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.22*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PanelBorder}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="46" /><RowDefinition Height="46" /><RowDefinition Height="46" /><RowDefinition Height="46" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <CheckBox x:Name="Earth50Enabled" Content="50N instantaneous earth fault" FontWeight="SemiBold" IsChecked="True" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed" />
                                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Pickup I0&gt;&gt;" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Earth50PickupText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Definite delay" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Earth50DelayText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Dropout ratio" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Earth50DropoutText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Border Grid.Row="4" Background="#F7F9FB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6">
                                    <TextBlock x:Name="Earth50EquivalentText" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <TextBlock Grid.Row="5" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" Text="The operating quantity is measured neutral current when mapped, otherwise the calculated residual IA + IB + IC." />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="42" />
                                    <RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="42" />
                                    <RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="Earth51Enabled" Content="51N time earth fault" FontWeight="SemiBold" IsChecked="True" Checked="AnySetting_Changed" Unchecked="AnySetting_Changed" />
                                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Pickup I0s" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Earth51PickupText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Characteristic" Style="{StaticResource FieldLabel}" /><ComboBox Grid.Column="1" x:Name="Earth51CurveCombo" Style="{StaticResource SettingCombo}" SelectionChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="TMS / time dial" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Earth51TmsText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Definite delay" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Earth51DefiniteText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Minimum operate time" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Earth51MinimumText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Dropout ratio" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Earth51DropoutText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="7"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Reset characteristic" Style="{StaticResource FieldLabel}" /><ComboBox Grid.Column="1" x:Name="Earth51ResetCombo" Style="{StaticResource SettingCombo}" SelectionChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="8"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Reset time" Style="{StaticResource FieldLabel}" /><TextBox Grid.Column="1" x:Name="Earth51ResetTimeText" Style="{StaticResource SettingTextBox}" TextChanged="AnySetting_Changed" /></Grid>
                                <Grid Grid.Row="9"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="User curve K / α / C" Style="{StaticResource FieldLabel}" /><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="Earth51KText" Width="68" Margin="0,0,5,0" TextChanged="AnySetting_Changed" /><TextBox x:Name="Earth51AlphaText" Width="68" Margin="0,0,5,0" TextChanged="AnySetting_Changed" /><TextBox x:Name="Earth51CText" Width="68" TextChanged="AnySetting_Changed" /></StackPanel></Grid>
                                <Border Grid.Row="10" Background="#F7F9FB" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6">
                                    <TextBlock x:Name="Earth51EquivalentText" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <TextBlock Grid.Row="11" x:Name="Earth51PreviewText" Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="10.2" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText" Text="Active settings loaded." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="10.5" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource LeanButton}" Margin="0,0,6,0" Click="LoadPreset_Click">
                    <StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="FolderOpen" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" /><TextBlock Text="Load preset" /></StackPanel>
                </Button>
                <Button Style="{StaticResource LeanButton}" Margin="0,0,6,0" Click="SavePreset_Click">
                    <StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="Save" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" /><TextBlock Text="Save preset" /></StackPanel>
                </Button>
                <Button Style="{StaticResource LeanButton}" Margin="0,0,6,0" Click="RestoreDefaults_Click">
                    <StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="RotateCcw" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" /><TextBlock Text="Defaults" /></StackPanel>
                </Button>
                <Button Style="{StaticResource LeanButton}" Margin="0,0,6,0" IsCancel="True">
                    <StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="X" Width="14" Height="14" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" /><TextBlock Text="Cancel" /></StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="Apply_Click">
                    <StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="Save" Filled="True" Width="14" Height="14" Foreground="White" Margin="0,0,6,0" /><TextBlock Text="Apply settings" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
