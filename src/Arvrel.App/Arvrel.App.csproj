<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <AssemblyName>ARVREL</AssemblyName>
    <RootNamespace>Arvrel.App</RootNamespace>
    <Product>ARVREL — Virtual Protection Relay Lab</Product>
    <Description>Premium IEC 61850 Sampled Values virtual protection relay laboratory.</Description>
    <ApplicationIcon>..\..\Asset\icon\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arvrel.Application\Arvrel.Application.csproj" />
    <ProjectReference Include="..\Arvrel.Protection\Arvrel.Protection.csproj" />
    <ProjectReference Include="..\Arvrel.ProcessBus\Arvrel.ProcessBus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\Asset\icon\favicon.ico">
      <Link>Assets\Branding\favicon.ico</Link>
    </Resource>
    <Resource Include="..\..\Asset\icon\arvrel_icon.png">
      <Link>Assets\Branding\arvrel_icon.png</Link>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <!-- The original non-P2 faceplate implementation remains source history only. -->
    <Compile Remove="MainWindow.RelayFaceplate.cs" />

    <!-- P6 owns all relay hardware geometry and materials. Keep the legacy files
         for audit history and source-level regression context, but do not compile
         their runtime mutation bootstraps into the WPF application. -->
    <Compile Remove="MainWindow.RelayHardwarePresentation.cs" />
    <Compile Remove="MainWindow.RelayFullFaceGloss.cs" />
    <Compile Remove="MainWindow.RelayLedPresentation.cs" />
    <Compile Remove="MainWindow.RelayPremiumButtonTuning.cs" />
    <Compile Remove="Controls\RelayIndicatorLampBehavior.cs" />
    <Compile Remove="Controls\RelayTactileButtonBehavior.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(HasARIEC61850Sibling)' == 'true'">
    <DefineConstants>$(DefineConstants);ARIEC61850_SIBLING</DefineConstants>
  </PropertyGroup>
</Project>
