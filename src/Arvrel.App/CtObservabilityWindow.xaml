<Window x:Class="Arvrel.App.CtObservabilityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Arvrel.App.Controls"
        Title="ARVREL · CT Observability"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource UxShellBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="Badge"
                    MinWidth="78"
                    Height="34"
                    Padding="10,0"
                    Margin="0,0,12,0"
                    CornerRadius="5"
                    BorderThickness="1"
                    VerticalAlignment="Top">
                <TextBlock x:Name="BadgeText"
                           Text="CT IDEAL"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Current transformer observability"
                           Style="{StaticResource UxSectionTitleStyle}"
                           FontSize="15" />
                <TextBlock x:Name="StatusText"
                           Margin="0,3,0,0"
                           FontSize="10.8"
                           Foreground="{StaticResource UxMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource UxPanelBorderStyle}"
                Padding="12,9"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SettingsText"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="10.1"
                           Foreground="#40515E"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="1"
                           x:Name="RuntimeText"
                           Margin="0,3,0,0"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="10.1"
                           Foreground="{StaticResource UxMutedBrush}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource UxPanelBorderStyle}"
                Margin="0,0,0,10">
            <UniformGrid Rows="1" Columns="5">
                <Border Padding="12,10" BorderBrush="{StaticResource UxLineBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="CHANNEL / STATE" Style="{StaticResource UxMetricLabelStyle}" />
                        <TextBlock x:Name="MetricChannelText" Text="—" Style="{StaticResource UxMetricValueStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Padding="12,10" BorderBrush="{StaticResource UxLineBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="FLUX MAX" Style="{StaticResource UxMetricLabelStyle}" />
                        <TextBlock x:Name="MetricFluxText" Text="—" Style="{StaticResource UxMetricValueStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Padding="12,10" BorderBrush="{StaticResource UxLineBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="SECONDARY RMS" Style="{StaticResource UxMetricLabelStyle}" />
                        <TextBlock x:Name="MetricRmsText" Text="—" Style="{StaticResource UxMetricValueStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Padding="12,10" BorderBrush="{StaticResource UxLineBrush}" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="RATIO ERROR" Style="{StaticResource UxMetricLabelStyle}" />
                        <TextBlock x:Name="MetricRatioText" Text="—" Style="{StaticResource UxMetricValueStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="WAVE ERROR / ONSET" Style="{StaticResource UxMetricLabelStyle}" />
                        <TextBlock x:Name="MetricWaveText" Text="—" Style="{StaticResource UxMetricValueStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource UxPanelBorderStyle}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="IDEAL PRIMARY-REFERRED / RELAY SECONDARY"
                               Style="{StaticResource UxMetricLabelStyle}"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center" />
                    <controls:CtComparisonScope Grid.Row="1" x:Name="Scope" />
                </Grid>
            </Border>

            <Expander Grid.Row="1"
                      IsExpanded="True"
                      Margin="0,10,0,0"
                      Background="Transparent">
                <Expander.Header>
                    <TextBlock Text="CHANNEL DETAILS"
                               Style="{StaticResource UxMetricLabelStyle}"
                               Margin="2,0,0,4" />
                </Expander.Header>
                <DataGrid x:Name="Table"
                          Style="{StaticResource UxDataGridStyle}"
                          Height="156"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="62" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="88" />
                        <DataGridTextColumn Header="Flux start" Binding="{Binding InitialFlux}" Width="76" />
                        <DataGridTextColumn Header="Flux end" Binding="{Binding FinalFlux}" Width="76" />
                        <DataGridTextColumn Header="Flux max" Binding="{Binding MaximumFlux}" Width="76" />
                        <DataGridTextColumn Header="Ideal → sec RMS" Binding="{Binding Rms}" Width="116" />
                        <DataGridTextColumn Header="Ratio err" Binding="{Binding RatioError}" Width="74" />
                        <DataGridTextColumn Header="Wave err" Binding="{Binding WaveformError}" Width="74" />
                        <DataGridTextColumn Header="Excitation" Binding="{Binding Excitation}" Width="80" />
                        <DataGridTextColumn Header="V sec max" Binding="{Binding SecondaryVoltage}" Width="82" />
                        <DataGridTextColumn Header="Onset" Binding="{Binding Onset}" Width="104" />
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="BoundaryText"
                       Margin="2,0,14,0"
                       FontSize="9.4"
                       Foreground="{StaticResource UxMutedBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ResetButton"
                        Style="{StaticResource UxQuietButtonStyle}"
                        Content="Reset CT state"
                        ToolTip="Reapply configured signed remanence while keeping source phase and DC time continuous."
                        Click="ResetButton_Click" />
                <Button x:Name="DemagnetizeButton"
                        Style="{StaticResource UxQuietButtonStyle}"
                        Margin="6,0,0,0"
                        Content="Demagnetize CT"
                        ToolTip="Set runtime CT flux to zero without changing configured remanence or source event time."
                        Click="DemagnetizeButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
