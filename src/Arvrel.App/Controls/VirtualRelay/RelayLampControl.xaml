<UserControl x:Class="Arvrel.App.Controls.VirtualRelay.RelayLampControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="21"
             Height="21"
             SnapsToDevicePixels="False"
             UseLayoutRounding="True"
             IsHitTestVisible="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="VirtualRelayTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Width="21" Height="21">
        <!-- A restrained emitted halo stays behind the complete physical lamp. -->
        <Ellipse x:Name="Halo"
                 Width="14"
                 Height="14"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Opacity="0" />

        <!-- Common metal bezel used by Healthy, Pickup, Trip and SMV Block. -->
        <Ellipse Width="21"
                 Height="21"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="{StaticResource VrLampBezelBrush}">
            <Ellipse.Effect>
                <DropShadowEffect Color="#11181D"
                                  BlurRadius="4.5"
                                  Direction="315"
                                  ShadowDepth="1.35"
                                  Opacity="0.76"
                                  RenderingBias="Quality" />
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse Width="16.6"
                 Height="16.6"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="{StaticResource VrLampCavityBrush}" />

        <Ellipse Width="13.5"
                 Height="13.5"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="#0B1013"
                 Stroke="#65747C"
                 StrokeThickness="0.55" />

        <!-- MainWindow keeps writing logical state colours to this exact lens. -->
        <Ellipse x:Name="Lens"
                 x:FieldModifier="public"
                 Width="12"
                 Height="12"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="{StaticResource VrOffBrush}" />

        <!-- P1: one radial 3D optical model for every active state colour. -->
        <Ellipse x:Name="LensOptic"
                 Width="12"
                 Height="12"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="Transparent"
                 Opacity="0" />

        <Ellipse Width="12"
                 Height="12"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="{StaticResource VrLampShadeBrush}" />

        <Ellipse x:Name="LensRim"
                 Width="12"
                 Height="12"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="Transparent"
                 Stroke="#B8FFFFFF"
                 StrokeThickness="0.65"
                 Opacity="0.30" />

        <Ellipse x:Name="LowerReflection"
                 Width="7.2"
                 Height="2.8"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="#42000000"
                 Opacity="0.22"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TranslateTransform X="0.7" Y="3.1" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="Highlight"
                 Width="3.8"
                 Height="2.5"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="#E8FFFFFF"
                 Opacity="0.28"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TranslateTransform X="-2.5" Y="-2.8" />
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</UserControl>
