<UserControl x:Class="Arvrel.App.Controls.VirtualRelay.VirtualRelayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Arvrel.App.Controls"
             xmlns:vr="clr-namespace:Arvrel.App.Controls.VirtualRelay"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="VirtualRelayTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
        <Grid Width="560" Height="710" Margin="8">
            <Border CornerRadius="25"
                    Background="{StaticResource VrOuterShellBrush}"
                    BorderBrush="{StaticResource VrOuterShellBorderBrush}"
                    BorderThickness="2"
                    Effect="{StaticResource VrShellShadow}" />

            <Border Margin="12"
                    CornerRadius="21"
                    Background="#151D22"
                    BorderBrush="#69757C"
                    BorderThickness="1.2" />

            <Border Margin="20"
                    CornerRadius="16"
                    Background="{StaticResource VrFrontFaceBrush}"
                    BorderBrush="{StaticResource VrFrontFaceBorderBrush}"
                    BorderThickness="1.4">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="314" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="174" />
                        <RowDefinition Height="49" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ARVREL"
                                           Foreground="{StaticResource VrTextBrush}"
                                           FontFamily="Segoe UI Semibold, Segoe UI"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text=" 650"
                                           Foreground="{StaticResource VrAccentBrush}"
                                           FontFamily="Segoe UI Semibold, Segoe UI"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="PROCESS BUS PROTECTION RELAY"
                                       Style="{StaticResource VrMicroLabelStyle}"
                                       Margin="1,3,0,0" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="10,6"
                                VerticalAlignment="Center"
                                CornerRadius="5"
                                Background="#202A30"
                                BorderBrush="#69767E"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ARV-650"
                                           Foreground="{StaticResource VrTextBrush}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="10.8"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="IEC 61850 SV"
                                           Foreground="{StaticResource VrMutedTextBrush}"
                                           FontSize="9.6" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="95" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                CornerRadius="10"
                                Background="{StaticResource VrModuleBrush}"
                                BorderBrush="{StaticResource VrModuleBorderBrush}"
                                BorderThickness="1.4"
                                Effect="{StaticResource VrModuleShadow}">
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="33" />
                                    <RowDefinition Height="33" />
                                    <RowDefinition Height="33" />
                                    <RowDefinition Height="33" />
                                    <RowDefinition Height="33" />
                                    <RowDefinition Height="33" />
                                    <RowDefinition Height="33" />
                                    <RowDefinition Height="33" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.ColumnSpan="2"
                                           Text="STATUS"
                                           Foreground="{StaticResource VrMutedTextBrush}"
                                           FontSize="10.2"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Text="HEALTHY" Style="{StaticResource VrStatusLabelStyle}" />
                                <vr:RelayLampControl Grid.Row="1" Grid.Column="1" x:Name="HealthyLamp" x:FieldModifier="public" />

                                <TextBlock Grid.Row="2" Text="PICKUP" Style="{StaticResource VrStatusLabelStyle}" />
                                <vr:RelayLampControl Grid.Row="2" Grid.Column="1" x:Name="PickupLamp" x:FieldModifier="public" />

                                <TextBlock Grid.Row="3" Text="TRIP" Style="{StaticResource VrStatusLabelStyle}" />
                                <vr:RelayLampControl Grid.Row="3" Grid.Column="1" x:Name="TripLamp" x:FieldModifier="public" />

                                <TextBlock Grid.Row="4" Text="PHASE A" Style="{StaticResource VrStatusLabelStyle}" />
                                <vr:RelayLampControl Grid.Row="4" Grid.Column="1" x:Name="PhaseALamp" x:FieldModifier="public" />

                                <TextBlock Grid.Row="5" Text="PHASE B" Style="{StaticResource VrStatusLabelStyle}" />
                                <vr:RelayLampControl Grid.Row="5" Grid.Column="1" x:Name="PhaseBLamp" x:FieldModifier="public" />

                                <TextBlock Grid.Row="6" Text="PHASE C" Style="{StaticResource VrStatusLabelStyle}" />
                                <vr:RelayLampControl Grid.Row="6" Grid.Column="1" x:Name="PhaseCLamp" x:FieldModifier="public" />

                                <TextBlock Grid.Row="7" Text="EARTH" Style="{StaticResource VrStatusLabelStyle}" />
                                <vr:RelayLampControl Grid.Row="7" Grid.Column="1" x:Name="EarthLamp" x:FieldModifier="public" />

                                <TextBlock Grid.Row="8" Text="SMV BLOCK" Style="{StaticResource VrStatusLabelStyle}" />
                                <vr:RelayLampControl Grid.Row="8" Grid.Column="1" x:Name="BlockLamp" x:FieldModifier="public" />

                                <Border Grid.ColumnSpan="2"
                                        Width="3"
                                        Margin="-10,31,0,4"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource VrAccentBrush}"
                                        Opacity="0.72"
                                        CornerRadius="2" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                CornerRadius="8"
                                Background="{StaticResource VrLcdBezelBrush}"
                                BorderBrush="#65737B"
                                BorderThickness="1.3"
                                Padding="7"
                                Effect="{StaticResource VrModuleShadow}">
                            <Border CornerRadius="4"
                                    Background="{StaticResource VrLcdFaceBrush}"
                                    BorderBrush="#101619"
                                    BorderThickness="1">
                                <Grid ClipToBounds="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="27" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="29" />
                                    </Grid.RowDefinitions>

                                    <Border Background="#4B7086" Padding="8,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="BAY 12 · FEEDER"
                                                       Foreground="#F3F7F8"
                                                       FontSize="9.4"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="SV READY"
                                                       Foreground="#DCE8ED"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="9"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="1"
                                                x:Name="LcdContentHost"
                                                Margin="11,9,11,7">
                                        <TextBlock x:Name="LcdHeaderText"
                                                   x:FieldModifier="public"
                                                   Text="MEASUREMENTS · SECONDARY"
                                                   Foreground="{StaticResource VrLcdTextBrush}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="11.2"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8" />
                                        <TextBlock Text="IA          1.00 A&#x0a;IB          1.02 A&#x0a;IC          0.98 A&#x0a;3I0         0.02 A"
                                                   Foreground="{StaticResource VrLcdTextBrush}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10.4"
                                                   LineHeight="17" />
                                        <Border Height="1" Background="#8EA09A" Margin="0,8,0,6" />
                                        <TextBlock Text="READY · ENTER MENU"
                                                   Foreground="{StaticResource VrLcdMutedBrush}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="9.4" />
                                    </StackPanel>

                                    <UniformGrid Grid.Row="2" Rows="1" Columns="4">
                                        <Border Background="#426F8C" BorderBrush="#294E65" BorderThickness="0,1,1,0">
                                            <TextBlock Text="MEASURE" Foreground="White" FontSize="8.6" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Background="#CAD4D1" BorderBrush="#899995" BorderThickness="0,1,1,0">
                                            <TextBlock Text="EVENTS" Foreground="{StaticResource VrLcdTextBrush}" FontSize="8.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Background="#CAD4D1" BorderBrush="#899995" BorderThickness="0,1,1,0">
                                            <TextBlock Text="RECORDS" Foreground="{StaticResource VrLcdTextBrush}" FontSize="8.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Background="#CAD4D1" BorderBrush="#899995" BorderThickness="0,1,0,0">
                                            <TextBlock Text="SETUP" Foreground="{StaticResource VrLcdTextBrush}" FontSize="8.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                        </Border>

                        <Border Grid.Column="4"
                                CornerRadius="9"
                                Background="{StaticResource VrModuleBrush}"
                                BorderBrush="{StaticResource VrModuleBorderBrush}"
                                BorderThickness="1.3"
                                Effect="{StaticResource VrModuleShadow}">
                            <StackPanel Margin="12,10" HorizontalAlignment="Center">
                                <Button Tag="P6_NATIVE" Style="{StaticResource VrFunctionKeyStyle}" Content="F1" ToolTip="Context function F1" />
                                <Button Tag="P6_NATIVE" Style="{StaticResource VrFunctionKeyStyle}" Content="F2" ToolTip="Context function F2" />
                                <Button Tag="P6_NATIVE" Style="{StaticResource VrFunctionKeyStyle}" Content="F3" ToolTip="Context function F3" />
                                <Button Tag="P6_NATIVE" Style="{StaticResource VrFunctionKeyStyle}" Content="F4" ToolTip="Context function F4" />
                                <Button Tag="P6_NATIVE" Style="{StaticResource VrFunctionKeyStyle}" Content="F5" ToolTip="Context function F5" />
                                <Button Tag="P6_NATIVE"
                                        Style="{StaticResource VrResetKeyStyle}"
                                        Content="RESET"
                                        ToolTip="Relay reset"
                                        Click="ResetButton_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3"
                            CornerRadius="11"
                            Background="{StaticResource VrModuleBrush}"
                            BorderBrush="{StaticResource VrModuleBorderBrush}"
                            BorderThickness="1.3"
                            Effect="{StaticResource VrModuleShadow}">
                        <Grid Margin="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="98" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="98" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button Tag="P6_NATIVE" Style="{StaticResource VrHardwareKeyStyle}" ToolTip="Home page">
                                    <controls:LucideIcon Kind="House" Width="18" Height="18" Foreground="{StaticResource VrKeyTextBrush}" />
                                </Button>
                                <Button Tag="P6_NATIVE" Style="{StaticResource VrHardwareKeyStyle}" ToolTip="Main menu">
                                    <controls:LucideIcon Kind="Menu" Width="18" Height="18" Foreground="{StaticResource VrKeyTextBrush}" />
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="184"
                                    Height="148"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="18"
                                    BorderBrush="{StaticResource VrAccentMutedBrush}"
                                    BorderThickness="2"
                                    Background="#1A2328">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="48" />
                                        <RowDefinition Height="48" />
                                        <RowDefinition Height="48" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Row="0" Grid.Column="1" Margin="2" Tag="P6_NATIVE" Style="{StaticResource VrHardwareKeyStyle}" ToolTip="Up">
                                        <controls:LucideIcon Kind="ChevronUp" Width="19" Height="19" Foreground="{StaticResource VrKeyTextBrush}" />
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="0" Margin="2" Tag="P6_NATIVE" Style="{StaticResource VrHardwareKeyStyle}" ToolTip="Cancel">
                                        <controls:LucideIcon Kind="ChevronLeft" Width="19" Height="19" Foreground="{StaticResource VrKeyTextBrush}" />
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="1" Margin="2" Tag="P6_NATIVE" Style="{StaticResource VrHardwareKeyStyle}" ToolTip="Enter" Content="OK" />
                                    <Button Grid.Row="1" Grid.Column="2" Margin="2" Tag="P6_NATIVE" Style="{StaticResource VrHardwareKeyStyle}" ToolTip="Next">
                                        <controls:LucideIcon Kind="ChevronRight" Width="19" Height="19" Foreground="{StaticResource VrKeyTextBrush}" />
                                    </Button>
                                    <Button Grid.Row="2" Grid.Column="1" Margin="2" Tag="P6_NATIVE" Style="{StaticResource VrHardwareKeyStyle}" ToolTip="Down">
                                        <controls:LucideIcon Kind="ChevronDown" Width="19" Height="19" Foreground="{StaticResource VrKeyTextBrush}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="54" />
                                    <RowDefinition Height="54" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Tag="P6_NATIVE" Style="{StaticResource VrHardwareKeyStyle}" ToolTip="Back">
                                    <controls:LucideIcon Kind="CornerUpLeft" Width="18" Height="18" Foreground="{StaticResource VrKeyTextBrush}" />
                                </Button>
                                <Button Grid.Row="1" Tag="P6_NATIVE" Style="{StaticResource VrHardwareKeyStyle}" ToolTip="Favorite page">
                                    <controls:LucideIcon Kind="Star" Width="18" Height="18" Foreground="{StaticResource VrKeyTextBrush}" />
                                </Button>
                                <Border Grid.Row="2"
                                        Width="48"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="4"
                                        Background="#171F24"
                                        BorderBrush="#69767D"
                                        BorderThickness="1">
                                    <Grid>
                                        <Border Height="3" Margin="7,4,7,0" VerticalAlignment="Top" Background="{StaticResource VrAccentBrush}" CornerRadius="2" />
                                        <TextBlock Text="USB" Foreground="#8797A0" FontSize="8.8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" Margin="2,8,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="VIRTUAL TRIP OUTPUT ONLY" Style="{StaticResource VrMicroLabelStyle}" />
                            <TextBlock x:Name="RelayFooterText"
                                       x:FieldModifier="public"
                                       Text="GROUP A · REV 1 · SMV TRUST ACTIVE"
                                       Foreground="{StaticResource VrMutedTextBrush}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="9.6"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Width="94"
                                Height="4"
                                VerticalAlignment="Center"
                                CornerRadius="2"
                                Background="{StaticResource VrAccentBrush}"
                                Opacity="0.62" />
                    </Grid>

                    <StackPanel Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="LcdIaText" x:FieldModifier="public" Text="1.00 A" />
                        <TextBlock x:Name="LcdIbText" x:FieldModifier="public" Text="1.02 A" />
                        <TextBlock x:Name="LcdIcText" x:FieldModifier="public" Text="0.98 A" />
                        <TextBlock x:Name="LcdResidualText" x:FieldModifier="public" Text="0.02 A" />
                        <TextBlock x:Name="LcdStatusText" x:FieldModifier="public" Text="READY" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
