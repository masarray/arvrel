<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      P0 / P6 design read
      Precision industrial protection HMI · trust-first · low glare · high legibility.
      ARVREL blue is shared with the application shell. Depth is expressed with
      restrained material separation rather than decorative gloss or neon.
    -->

    <Color x:Key="VrAccentColor">#2E6F9E</Color>
    <Color x:Key="VrHealthyColor">#45B768</Color>
    <Color x:Key="VrPickupColor">#D6A23B</Color>
    <Color x:Key="VrTripColor">#DC4D4D</Color>
    <Color x:Key="VrOffColor">#52636D</Color>

    <SolidColorBrush x:Key="VrAccentBrush" Color="{StaticResource VrAccentColor}" />
    <SolidColorBrush x:Key="VrAccentMutedBrush" Color="#416C85" />
    <SolidColorBrush x:Key="VrTextBrush" Color="#E8EEF1" />
    <SolidColorBrush x:Key="VrMutedTextBrush" Color="#A7B5BD" />
    <SolidColorBrush x:Key="VrDarkTextBrush" Color="#283942" />
    <SolidColorBrush x:Key="VrLcdTextBrush" Color="#30444B" />
    <SolidColorBrush x:Key="VrLcdMutedBrush" Color="#62777D" />
    <SolidColorBrush x:Key="VrKeyTextBrush" Color="#F0F4F6" />
    <SolidColorBrush x:Key="VrOffBrush" Color="{StaticResource VrOffColor}" />

    <LinearGradientBrush x:Key="VrOuterShellBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#465158" Offset="0" />
        <GradientStop Color="#2D373D" Offset="0.52" />
        <GradientStop Color="#1A2227" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VrOuterShellBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7B888F" Offset="0" />
        <GradientStop Color="#455159" Offset="0.52" />
        <GradientStop Color="#11181C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VrFrontFaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#465158" Offset="0" />
        <GradientStop Color="#3A454C" Offset="0.38" />
        <GradientStop Color="#303A40" Offset="0.72" />
        <GradientStop Color="#283137" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VrFrontFaceBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#87949B" Offset="0" />
        <GradientStop Color="#536068" Offset="0.42" />
        <GradientStop Color="#151D21" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VrModuleBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#303A40" Offset="0" />
        <GradientStop Color="#273137" Offset="0.58" />
        <GradientStop Color="#222A2F" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VrModuleBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5B6971" Offset="0" />
        <GradientStop Color="#344149" Offset="0.52" />
        <GradientStop Color="#151C20" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VrLcdBezelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#151D21" Offset="0" />
        <GradientStop Color="#303B42" Offset="0.44" />
        <GradientStop Color="#0D1316" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VrLcdFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EEF3EF" Offset="0" />
        <GradientStop Color="#E4EAE5" Offset="0.54" />
        <GradientStop Color="#D7E0DA" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VrKeyFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A555C" Offset="0" />
        <GradientStop Color="#354047" Offset="0.40" />
        <GradientStop Color="#273036" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VrKeyBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#849198" Offset="0" />
        <GradientStop Color="#56636B" Offset="0.48" />
        <GradientStop Color="#171E22" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VrLampBezelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DCE3E6" Offset="0" />
        <GradientStop Color="#9DA9AF" Offset="0.28" />
        <GradientStop Color="#4C5960" Offset="0.65" />
        <GradientStop Color="#141B1F" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="VrLampCavityBrush"
                         Center="0.50,0.50"
                         GradientOrigin="0.34,0.28"
                         RadiusX="0.72"
                         RadiusY="0.72">
        <GradientStop Color="#65747C" Offset="0" />
        <GradientStop Color="#2D383E" Offset="0.55" />
        <GradientStop Color="#090D0F" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="VrLampShadeBrush"
                         Center="0.50,0.50"
                         GradientOrigin="0.28,0.22"
                         RadiusX="0.76"
                         RadiusY="0.76">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#02000000" Offset="0.44" />
        <GradientStop Color="#3B000000" Offset="0.82" />
        <GradientStop Color="#78000000" Offset="1" />
    </RadialGradientBrush>

    <DropShadowEffect x:Key="VrShellShadow"
                      Color="#10171B"
                      BlurRadius="14"
                      Direction="315"
                      ShadowDepth="5"
                      Opacity="0.38"
                      RenderingBias="Performance" />

    <DropShadowEffect x:Key="VrModuleShadow"
                      Color="#090D10"
                      BlurRadius="5"
                      Direction="315"
                      ShadowDepth="2"
                      Opacity="0.30"
                      RenderingBias="Performance" />

    <Style x:Key="VrHardwareKeyStyle" TargetType="Button">
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="43" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource VrKeyTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Grid.RenderTransform>
                        <Border x:Name="Well"
                                Margin="0,3,0,0"
                                CornerRadius="7"
                                Background="#12191D"
                                BorderBrush="#5D6B73"
                                BorderThickness="1" />
                        <Border x:Name="Depth"
                                Margin="2,6,2,0"
                                CornerRadius="6"
                                Background="#0B1013" />
                        <Border x:Name="Face"
                                Margin="1,0,1,4"
                                CornerRadius="6"
                                Background="{StaticResource VrKeyFaceBrush}"
                                BorderBrush="{StaticResource VrKeyBorderBrush}"
                                BorderThickness="1">
                            <Grid ClipToBounds="True">
                                <Border x:Name="TopHighlight"
                                        Height="6"
                                        Margin="2,1,2,0"
                                        VerticalAlignment="Top"
                                        CornerRadius="5,5,2,2">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#28FFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="HoverLayer" CornerRadius="5" Background="Transparent" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="Background" Value="#0BFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="0.25" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Face" Property="Margin" Value="1,0.25,1,3.75" />
                            <Setter TargetName="TopHighlight" Property="Opacity" Value="0.60" />
                            <Setter TargetName="Depth" Property="Opacity" Value="0.86" />
                            <Setter TargetName="HoverLayer" Property="Background" Value="#06000000" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VrFunctionKeyStyle"
           TargetType="Button"
           BasedOn="{StaticResource VrHardwareKeyStyle}">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="39" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style x:Key="VrResetKeyStyle"
           TargetType="Button"
           BasedOn="{StaticResource VrHardwareKeyStyle}">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="39" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="10.8" />
        <Setter Property="Foreground" Value="{StaticResource VrAccentBrush}" />
    </Style>

    <Style x:Key="VrStatusLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource VrTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold, Segoe UI" />
        <Setter Property="FontSize" Value="10.8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="VrMicroLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource VrMutedTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold, Segoe UI" />
        <Setter Property="FontSize" Value="10.2" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
</ResourceDictionary>
