<UserControl x:Class="Arvrel.App.Controls.Avr.AvrWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="900"
             MinHeight="560">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AvrPanel" Color="#F7F9FA" />
        <SolidColorBrush x:Key="AvrLine" Color="#CBD4DA" />
        <SolidColorBrush x:Key="AvrMuted" Color="#667985" />
        <SolidColorBrush x:Key="AvrAccent" Color="#2E6F9E" />
        <SolidColorBrush x:Key="AvrHealthy" Color="#3F8E58" />
        <SolidColorBrush x:Key="AvrWarn" Color="#B47A22" />
        <SolidColorBrush x:Key="AvrTrip" Color="#B84945" />
        <SolidColorBrush x:Key="AvrBody" Color="#D9E0E5" />
        <Style x:Key="AvrSection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AvrMuted}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="AvrValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#24333D" />
        </Style>
        <Style x:Key="AvrButton" TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="AvrTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="11">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.6*" MinWidth="650" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="0.82*" MinWidth="330" MaxWidth="455" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource AvrPanel}" BorderBrush="{StaticResource AvrLine}" BorderThickness="1" CornerRadius="6" Padding="13,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Automatic voltage regulation" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="Vendor-neutral OLTC laboratory · setpoint, tolerance band, T1/T2 and tap limits" Foreground="{StaticResource AvrMuted}" FontSize="10.2" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="StateBadge" Background="#EAF5EC" BorderBrush="#B9D8BF" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock x:Name="StateBadgeText" Text="IN BAND" Foreground="{StaticResource AvrHealthy}" FontSize="9.5" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource AvrPanel}" BorderBrush="{StaticResource AvrLine}" BorderThickness="1" CornerRadius="6" Padding="13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="GRID / TEST SOURCE" Style="{StaticResource AvrSection}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SourceVoltageText" Text="100.00 V" FontFamily="Cascadia Mono, Consolas" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock Text="Equivalent VT secondary voltage before OLTC effect" Foreground="{StaticResource AvrMuted}" FontSize="10" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource AvrButton}" Click="SourceLow_Click" Content="−5%" />
                                <Button Style="{StaticResource AvrButton}" Click="SourceNominal_Click" Content="Nominal" />
                                <Button Style="{StaticResource AvrButton}" Click="SourceHigh_Click" Content="+5%" Margin="0" />
                            </StackPanel>
                        </Grid>
                        <Slider x:Name="SourceVoltageSlider" Minimum="70" Maximum="130" Value="100" TickFrequency="0.5" IsSnapToTickEnabled="False" Margin="0,11,0,0" ValueChanged="SourceVoltageSlider_ValueChanged" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="70%" Foreground="{StaticResource AvrMuted}" FontSize="9" />
                            <TextBlock Grid.Column="1" Text="100%" Foreground="{StaticResource AvrMuted}" FontSize="9" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="130%" Foreground="{StaticResource AvrMuted}" FontSize="9" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <UniformGrid Rows="1" Columns="4">
                            <StackPanel Margin="0,0,10,0"><TextBlock Text="MEASURED" Style="{StaticResource AvrSection}" /><TextBlock x:Name="MeasuredVoltageText" Text="100.00 V" Style="{StaticResource AvrValue}" /></StackPanel>
                            <StackPanel Margin="0,0,10,0"><TextBlock Text="SETPOINT" Style="{StaticResource AvrSection}" /><TextBlock x:Name="SetpointValueText" Text="100.00 V" Style="{StaticResource AvrValue}" /></StackPanel>
                            <StackPanel Margin="0,0,10,0"><TextBlock Text="DEVIATION" Style="{StaticResource AvrSection}" /><TextBlock x:Name="DeviationValueText" Text="+0.00 %" Style="{StaticResource AvrValue}" /></StackPanel>
                            <StackPanel><TextBlock Text="TAP" Style="{StaticResource AvrSection}" /><TextBlock x:Name="TapValueText" Text="0" Style="{StaticResource AvrValue}" /></StackPanel>
                        </UniformGrid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="REGULATION TIMER" Style="{StaticResource AvrSection}" />
                                <ProgressBar x:Name="DelayProgress" Height="7" Minimum="0" Maximum="100" Value="0" Margin="0,6,12,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="DelayText" Text="0.0 / 10.0 s" Style="{StaticResource AvrValue}" VerticalAlignment="Bottom" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4" Background="{StaticResource AvrPanel}" BorderBrush="{StaticResource AvrLine}" BorderThickness="1" CornerRadius="6" Padding="13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="REGULATOR CONFIGURATION" FontSize="12.5" FontWeight="SemiBold" /><TextBlock x:Name="ProfileText" Text="ARV-AVR Classic" Foreground="{StaticResource AvrMuted}" FontSize="9.8" /></StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource AvrButton}" Margin="0" Click="ApplySettings_Click" Content="Apply settings" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Setpoint (V)" Style="{StaticResource AvrSection}" /><TextBox x:Name="SetpointBox" Text="100" Style="{StaticResource AvrTextBox}" Margin="0,4,0,0" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Tolerance ± (%)" Style="{StaticResource AvrSection}" /><TextBox x:Name="ToleranceBox" Text="1.0" Style="{StaticResource AvrTextBox}" Margin="0,4,0,0" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="T1 delay (s)" Style="{StaticResource AvrSection}" /><TextBox x:Name="T1Box" Text="10" Style="{StaticResource AvrTextBox}" Margin="0,4,0,0" /></StackPanel>
                            <StackPanel Grid.Column="6"><TextBlock Text="T2 fast (s)" Style="{StaticResource AvrSection}" /><TextBox x:Name="T2Box" Text="2" Style="{StaticResource AvrTextBox}" Margin="0,4,0,0" /></StackPanel>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Tap min" Style="{StaticResource AvrSection}" /><TextBox x:Name="MinTapBox" Text="-8" Style="{StaticResource AvrTextBox}" Margin="0,4,0,0" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Tap max" Style="{StaticResource AvrSection}" /><TextBox x:Name="MaxTapBox" Text="8" Style="{StaticResource AvrTextBox}" Margin="0,4,0,0" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Step / tap (%)" Style="{StaticResource AvrSection}" /><TextBox x:Name="TapStepBox" Text="1.25" Style="{StaticResource AvrTextBox}" Margin="0,4,0,0" /></StackPanel>
                            <StackPanel Grid.Column="6"><TextBlock Text="LDC (%)" Style="{StaticResource AvrSection}" /><TextBox x:Name="LdcBox" Text="0" Style="{StaticResource AvrTextBox}" Margin="0,4,0,0" /></StackPanel>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="18" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="18" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <CheckBox x:Name="FastT2Check" Content="Enable fast T2 after first tap" IsChecked="True" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="2" x:Name="LdcCheck" Content="Line-drop compensation" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="Model intentionally vendor-neutral; workflow follows common AVR/OLTC practice." Foreground="{StaticResource AvrMuted}" FontSize="9.3" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <Border Grid.Column="2" Background="#FBFCFD" BorderBrush="{StaticResource AvrLine}" BorderThickness="1" CornerRadius="4" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="EVENT TRACE" Style="{StaticResource AvrSection}" />
                                <TextBlock Grid.Column="1" x:Name="OperationCountText" Text="OPS 0" Foreground="{StaticResource AvrMuted}" FontFamily="Cascadia Mono, Consolas" FontSize="9.2" />
                            </Grid>
                            <TextBlock Grid.Row="2" x:Name="EventTraceText" Text="READY      AVR simulator initialized" FontFamily="Cascadia Mono, Consolas" FontSize="9.7" Foreground="{StaticResource AvrMuted}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="#D3DBE1" BorderBrush="#9AA8B2" BorderThickness="1" CornerRadius="7" Padding="14">
            <Border Background="{StaticResource AvrBody}" BorderBrush="#7D8D98" BorderThickness="1" CornerRadius="8" Padding="15">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="ARVREL" Foreground="#24333D" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="AUTOMATIC VOLTAGE REGULATOR" Foreground="#596C78" FontSize="9" /></StackPanel>
                        <Border Grid.Column="1" Background="#EDF1F3" BorderBrush="#8C9AA4" BorderThickness="1" CornerRadius="3" Padding="7,4"><StackPanel><TextBlock Text="ARV-AVR" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" FontSize="10" /><TextBlock Text="OLTC CONTROL" FontSize="8" /></StackPanel></Border>
                    </Grid>

                    <Border Grid.Row="2" Background="#C7D3C8" BorderBrush="#7C8A80" BorderThickness="4" CornerRadius="6" Padding="13">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock x:Name="LcdModeText" Text="AUTO · IN BAND" FontFamily="Cascadia Mono, Consolas" Foreground="#24342A" FontSize="10.5" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="27" /><RowDefinition Height="27" /><RowDefinition Height="27" /><RowDefinition Height="27" /></Grid.RowDefinitions>
                                <TextBlock Text="U ACT" FontFamily="Cascadia Mono, Consolas" Foreground="#24342A" /><TextBlock Grid.Column="1" x:Name="LcdMeasuredText" Text="100.00 V" FontFamily="Cascadia Mono, Consolas" Foreground="#24342A" />
                                <TextBlock Grid.Row="1" Text="U SET" FontFamily="Cascadia Mono, Consolas" Foreground="#24342A" /><TextBlock Grid.Row="1" Grid.Column="1" x:Name="LcdSetpointText" Text="100.00 V" FontFamily="Cascadia Mono, Consolas" Foreground="#24342A" />
                                <TextBlock Grid.Row="2" Text="DEV" FontFamily="Cascadia Mono, Consolas" Foreground="#24342A" /><TextBlock Grid.Row="2" Grid.Column="1" x:Name="LcdDeviationText" Text="+0.00 %" FontFamily="Cascadia Mono, Consolas" Foreground="#24342A" />
                                <TextBlock Grid.Row="3" Text="TAP" FontFamily="Cascadia Mono, Consolas" Foreground="#24342A" /><TextBlock Grid.Row="3" Grid.Column="1" x:Name="LcdTapText" Text="0" FontFamily="Cascadia Mono, Consolas" Foreground="#24342A" />
                            </Grid>
                            <TextBlock Grid.Row="4" x:Name="LcdReasonText" Text="Voltage inside tolerance band" FontFamily="Cascadia Mono, Consolas" Foreground="#24342A" FontSize="9.2" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="STATUS" Style="{StaticResource AvrSection}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5"><Ellipse x:Name="AutoLed" Width="10" Height="10" Fill="#3F8E58" Margin="0,0,7,0" /><TextBlock Text="AUTO" FontSize="10" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5"><Ellipse x:Name="RaiseLed" Width="10" Height="10" Fill="#51606A" Margin="0,0,7,0" /><TextBlock Text="RAISE" FontSize="10" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5"><Ellipse x:Name="LowerLed" Width="10" Height="10" Fill="#51606A" Margin="0,0,7,0" /><TextBlock Text="LOWER" FontSize="10" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5"><Ellipse x:Name="BlockLed" Width="10" Height="10" Fill="#51606A" Margin="0,0,7,0" /><TextBlock Text="BLOCK" FontSize="10" /></StackPanel>
                            <StackPanel Orientation="Horizontal"><Ellipse x:Name="LimitLed" Width="10" Height="10" Fill="#51606A" Margin="0,0,7,0" /><TextBlock Text="TAP LIMIT" FontSize="10" /></StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="AutoModeButton" Style="{StaticResource AvrButton}" Width="92" Margin="0,0,0,6" Click="AutoMode_Click" Content="AUTO" />
                            <Button x:Name="ManualModeButton" Style="{StaticResource AvrButton}" Width="92" Margin="0,0,0,12" Click="ManualMode_Click" Content="MANUAL" />
                            <Button Style="{StaticResource AvrButton}" Width="92" Margin="0,0,0,6" Click="RaiseTap_Click" Content="RAISE TAP" />
                            <Button Style="{StaticResource AvrButton}" Width="92" Margin="0" Click="LowerTap_Click" Content="LOWER TAP" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="6">
                        <Border Height="1" Background="#AAB5BC" Margin="0,0,0,8" />
                        <TextBlock Text="SIMULATION ONLY · NO MOTOR DRIVE OUTPUT · NO PHYSICAL OLTC AUTHORITY" Foreground="#596C78" FontFamily="Cascadia Mono, Consolas" FontSize="8.6" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
