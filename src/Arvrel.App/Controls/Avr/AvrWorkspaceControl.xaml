<UserControl x:Class="Arvrel.App.Controls.Avr.AvrWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="1180"
             MinHeight="650"
             Background="#0D1620"
             Loaded="HmiLoaded"
             Unloaded="HmiUnloaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AvrPanel" Color="#142331" />
        <SolidColorBrush x:Key="AvrLine" Color="#314657" />
        <SolidColorBrush x:Key="AvrMuted" Color="#8FA7B8" />
        <SolidColorBrush x:Key="AvrText" Color="#E9F1F6" />
        <SolidColorBrush x:Key="AvrAccent" Color="#2E8BCB" />
        <SolidColorBrush x:Key="DeviceMetal" Color="#B8C0C5" />

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AvrMuted}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MonoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AvrText}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="29" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Foreground" Value="{StaticResource AvrText}" />
            <Setter Property="Background" Value="#0E1B26" />
            <Setter Property="BorderBrush" Value="{StaticResource AvrLine}" />
            <Setter Property="CaretBrush" Value="{StaticResource AvrText}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Foreground" Value="#EAF4F8" />
            <Setter Property="Background" Value="#203747" />
            <Setter Property="BorderBrush" Value="#405A6D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#3A647C" /><Setter TargetName="Chrome" Property="BorderBrush" Value="#7FC4E6" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#176A9D" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="#172631" /><Setter TargetName="Chrome" Property="BorderBrush" Value="#2A3C49" /><Setter Property="Foreground" Value="#687D8B" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryPanelButton" TargetType="Button" BasedOn="{StaticResource PanelButton}">
            <Setter Property="Background" Value="#176A9D" />
            <Setter Property="BorderBrush" Value="#43A1D6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DeviceButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E2F0F5" />
            <Setter Property="Background" Value="#35434A" />
            <Setter Property="BorderBrush" Value="#75858D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10.2" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="ACTIVE"><Setter TargetName="Chrome" Property="Background" Value="#17452E" /><Setter TargetName="Chrome" Property="BorderBrush" Value="#66C878" /><Setter Property="Foreground" Value="#DFFFF0" /><Setter Property="FontWeight" Value="Bold" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E7F1F5" /><Setter TargetName="Chrome" Property="BorderBrush" Value="#FFFFFF" /><Setter Property="Foreground" Value="#17313B" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#2E8BCB" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="#7D898F" /><Setter Property="Foreground" Value="#C8CFD2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HmiTab" TargetType="Border">
            <Setter Property="Background" Value="#E7EAED" />
            <Setter Property="BorderBrush" Value="#CFD4D8" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="8,7" />
        </Style>
        <Style x:Key="HmiLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A6870" />
            <Setter Property="FontSize" Value="9" />
        </Style>
        <Style x:Key="HmiValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2774AE" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ConfigTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource AvrMuted}" />
            <Setter Property="Background" Value="#142331" />
            <Setter Property="BorderBrush" Value="{StaticResource AvrLine}" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1C3141" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AvrAccent}" /><Setter Property="Foreground" Value="{StaticResource AvrText}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="390" MinWidth="365" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" MinWidth="500" /><ColumnDefinition Width="10" /><ColumnDefinition x:Name="ConfigurationColumn" Width="380" MinWidth="38" MaxWidth="430" /></Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="22" Height="22" CornerRadius="11" Background="#1E6D9E"><TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border><TextBlock Text="INJECT" Foreground="{StaticResource AvrText}" FontSize="11" FontWeight="SemiBold" Margin="8,3,0,0" /></StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="22" Height="22" CornerRadius="11" Background="#1E6D9E"><TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border><TextBlock Text="VIRTUAL DEVICE RESPONSE" Foreground="{StaticResource AvrText}" FontSize="11" FontWeight="SemiBold" Margin="8,3,0,0" /></StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="22" Height="22" CornerRadius="11" Background="#1E6D9E"><TextBlock Text="3" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="CONFIGURE / VALIDATE" Foreground="{StaticResource AvrText}" FontSize="11" FontWeight="SemiBold" Margin="8,3,0,0" /></StackPanel>

        <!-- Injection workspace -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource AvrPanel}" BorderBrush="{StaticResource AvrLine}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Background="#182A38" BorderBrush="{StaticResource AvrLine}" BorderThickness="0,0,0,1" Padding="12,9"><StackPanel><TextBlock Text="INJECTION FORM" Foreground="{StaticResource AvrText}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="Test-set stimulus at AVR terminals · configured target ≠ energized output" Foreground="{StaticResource AvrMuted}" FontSize="9.2" Margin="0,2,0,0" /></StackPanel></Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Text="TEST PLANT" Style="{StaticResource SectionLabel}" />
                        <RadioButton x:Name="BenchModeRadio" Content="External test set / bench injection" IsChecked="True" Foreground="{StaticResource AvrText}" Margin="0,6,0,4" Checked="InputModel_Changed" />
                        <RadioButton x:Name="ClosedLoopModeRadio" Content="Simulated transformer + OLTC feedback" Foreground="{StaticResource AvrText}" Checked="InputModel_Changed" />
                        <TextBlock Text="TEST PROFILE" Style="{StaticResource SectionLabel}" Margin="0,13,0,0" />
                        <ComboBox x:Name="TestProfileCombo" Height="30" Margin="0,5,0,12" SelectedIndex="0"><ComboBoxItem Content="AVR · Manual U/I injection" /><ComboBoxItem Content="AVR · Low U / RAISE" /><ComboBoxItem Content="AVR · High U / LOWER" /><ComboBoxItem Content="AVR · Band sweep" /><ComboBoxItem Content="AVR · U blocking" /><ComboBoxItem Content="AVR · I&lt; blocking" /><ComboBoxItem Content="AVR · I&gt; blocking" /></ComboBox>
                        <TextBlock Text="CONFIGURED SOURCE TARGET" Style="{StaticResource SectionLabel}" />
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel><TextBlock Text="Voltage U (V sec)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="InjectionVoltageBox" Text="100.00" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" LostFocus="InjectionForm_LostFocus" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Current I (A sec)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="InjectionCurrentBox" Text="1.00" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" LostFocus="InjectionForm_LostFocus" /></StackPanel>
                            <StackPanel Grid.Row="2"><TextBlock Text="Current angle φ (° vs U)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="CurrentAngleBox" Text="0.0" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" LostFocus="InjectionForm_LostFocus" /></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Frequency (Hz)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="FrequencyBox" Text="50.00" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" LostFocus="InjectionForm_LostFocus" /></StackPanel>
                        </Grid>
                        <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Voltage target" Style="{StaticResource SectionLabel}" /><TextBlock Grid.Column="1" x:Name="InjectionTargetText" Text="100.00 V" Style="{StaticResource MonoValue}" FontSize="10.5" /></Grid>
                        <Slider x:Name="SourceVoltageSlider" Minimum="70" Maximum="130" Value="100" TickFrequency="0.5" Margin="0,5,0,0" ValueChanged="SourceVoltageSlider_ValueChanged" />
                        <Grid Margin="0,2,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="70 V" Foreground="{StaticResource AvrMuted}" FontSize="8.5" /><TextBlock Grid.Column="1" Text="100 V" Foreground="{StaticResource AvrMuted}" FontSize="8.5" HorizontalAlignment="Center" /><TextBlock Grid.Column="2" Text="130 V" Foreground="{StaticResource AvrMuted}" FontSize="8.5" HorizontalAlignment="Right" /></Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Ramp U (V/s)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="RampBox" Text="200.0" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" LostFocus="InjectionForm_LostFocus" ToolTip="Ramp used for test steps after the initial fast source pickup" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Pre-delay (s)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="DelayBox" Text="0.10" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" LostFocus="InjectionForm_LostFocus" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Dwell (s)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="DwellBox" Text="8.0" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" LostFocus="InjectionForm_LostFocus" /></StackPanel>
                        </Grid>
                        <TextBlock Text="QUICK SCENARIOS" Style="{StaticResource SectionLabel}" Margin="0,13,0,6" />
                        <UniformGrid Columns="2" Rows="3"><Button Style="{StaticResource PanelButton}" Margin="0,0,5,5" Click="ScenarioRaise_Click" Content="Low U → RAISE" /><Button Style="{StaticResource PanelButton}" Margin="0,0,0,5" Click="ScenarioLower_Click" Content="High U → LOWER" /><Button Style="{StaticResource PanelButton}" Margin="0,0,5,5" Click="ScenarioBandSweep_Click" Content="Bandwidth sweep" /><Button Style="{StaticResource PanelButton}" Margin="0,0,0,5" Click="ScenarioVoltageBlocking_Click" Content="U&lt; / U&gt; block" /><Button Style="{StaticResource PanelButton}" Margin="0,0,5,0" Click="ScenarioUnderCurrent_Click" Content="I&lt; block" /><Button Style="{StaticResource PanelButton}" Click="ScenarioOverCurrent_Click" Content="I&gt; block" /></UniformGrid>
                        <Grid Margin="0,13,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="TEST SEQUENCE" Style="{StaticResource SectionLabel}" /><TextBlock Grid.Column="1" x:Name="SequenceStepText" Text="MANUAL" Foreground="{StaticResource AvrMuted}" FontFamily="Cascadia Mono, Consolas" FontSize="8.8" /></Grid>
                        <Border Background="#0F1D28" BorderBrush="{StaticResource AvrLine}" BorderThickness="1" CornerRadius="3" Padding="6"><ListBox x:Name="InjectionSequenceList" Height="92" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AvrMuted}" FontFamily="Cascadia Mono, Consolas" FontSize="8.8" /></Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Background="#101E29" BorderBrush="{StaticResource AvrLine}" BorderThickness="0,1,0,0" Padding="10">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions><Button x:Name="InjectionStartButton" Style="{StaticResource PrimaryPanelButton}" Click="StartInjection_Click" Content="▶  Start injection" /><Button x:Name="InjectionPauseButton" Grid.Column="2" Style="{StaticResource PanelButton}" Click="PauseInjection_Click" Content="Ⅱ  Pause" IsEnabled="False" /><Button Grid.Column="4" Style="{StaticResource PanelButton}" Click="StopInjection_Click" Content="■" ToolTip="De-energize test source" /></Grid>
                        <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Ellipse x:Name="InjectionLed" Width="8" Height="8" Fill="#51606A" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock x:Name="InjectionStatusText" Text="SOURCE OFF" Foreground="{StaticResource AvrMuted}" FontSize="9" /></StackPanel><TextBlock Grid.Column="1" x:Name="InjectedSourceText" Text="U 0.00 V · I 0.000 A" Style="{StaticResource MonoValue}" FontSize="9.2" /></Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Original vendor-neutral virtual AVR faceplate -->
        <Border Grid.Row="1" Grid.Column="2" Background="#7C878D" BorderBrush="#5B676E" BorderThickness="1" CornerRadius="7" Padding="10">
            <Border Background="{StaticResource DeviceMetal}" BorderBrush="#727E84" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="ARVREL" Foreground="#27343A" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="  AVR-230 LAB" Foreground="#526066" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,2" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="AUTOMATIC VOLTAGE CONTROL" Foreground="#44545B" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock Text="VIRTUAL OLTC CONTROLLER" Foreground="#66757B" FontSize="8" HorizontalAlignment="Right" /></StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Height="34" Background="#263238" BorderBrush="#738188" BorderThickness="1" CornerRadius="4" Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Ellipse x:Name="PowerLed" Width="8" Height="8" Fill="#66C878" Margin="0,0,5,0" /><TextBlock Text="PWR" Foreground="#DCE5E9" FontSize="8.5" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Ellipse x:Name="RunLed" Width="8" Height="8" Fill="#51606A" Margin="0,0,5,0" /><TextBlock Text="INPUT" Foreground="#DCE5E9" FontSize="8.5" /></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Ellipse x:Name="BlockLed" Width="8" Height="8" Fill="#51606A" Margin="0,0,5,0" /><TextBlock Text="BLOCK" Foreground="#DCE5E9" FontSize="8.5" /></StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="LimitLed" Width="8" Height="8" Fill="#51606A" Margin="0,0,5,0" /><TextBlock Text="TAP LIMIT" Foreground="#DCE5E9" FontSize="8.5" /></StackPanel></StackPanel>
                            <TextBlock Grid.Column="1" x:Name="DeviceClockText" Text="--:--:--" Foreground="#AFC0C8" FontFamily="Cascadia Mono, Consolas" FontSize="9" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="9" /><ColumnDefinition Width="*" /><ColumnDefinition Width="9" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <Button x:Name="LocalAuthorityButton" Style="{StaticResource DeviceButton}" Margin="0,0,0,7" Click="LocalAuthority_Click" Content="LOCAL" />
                            <Button x:Name="RemoteAuthorityButton" Style="{StaticResource DeviceButton}" Margin="0,0,0,14" Click="RemoteAuthority_Click" Content="REMOTE" />
                            <Button x:Name="AutoModeButton" Style="{StaticResource DeviceButton}" Margin="0,0,0,7" Click="AutoMode_Click" Content="AVR AUTO" />
                            <Button Style="{StaticResource DeviceButton}" Margin="0,0,0,7" Click="RaiseTap_Click" Content="▲ RAISE" />
                            <Button x:Name="ManualModeButton" Style="{StaticResource DeviceButton}" Margin="0,0,0,7" Click="ManualMode_Click" Content="MANUAL" />
                            <Button Style="{StaticResource DeviceButton}" Click="LowerTap_Click" Content="▼ LOWER" />
                        </StackPanel>

                        <!-- Bright HMI inspired by real AVR information hierarchy, with original ARVREL identity -->
                        <Border Grid.Column="2" Background="#F3F4F5" BorderBrush="#4D5B62" BorderThickness="4" CornerRadius="4">
                            <Grid ClipToBounds="True">
                                <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /><RowDefinition Height="27" /></Grid.RowDefinitions>

                                <Grid Grid.Row="0" Background="#E5E8EB">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Background="#245D9A"><TextBlock Text="HOME" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <Border Grid.Column="1" Style="{StaticResource HmiTab}"><TextBlock Text="Measured" Foreground="#303B41" FontSize="9.5" HorizontalAlignment="Center" /></Border>
                                    <Border Grid.Column="2" Style="{StaticResource HmiTab}"><TextBlock Text="Control" Foreground="#303B41" FontSize="9.5" HorizontalAlignment="Center" /></Border>
                                    <Border Grid.Column="3" Style="{StaticResource HmiTab}"><TextBlock Text="Events" Foreground="#303B41" FontSize="9.5" HorizontalAlignment="Center" /></Border>
                                    <Border Grid.Column="4" Style="{StaticResource HmiTab}"><TextBlock Text="System" Foreground="#303B41" FontSize="9.5" HorizontalAlignment="Center" /></Border>
                                </Grid>

                                <Grid Grid.Row="1" Margin="10,9,10,7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.35*" /></Grid.ColumnDefinitions>

                                    <!-- Transformer / measured values -->
                                    <Border Background="#FAFBFC" BorderBrush="#D4D9DD" BorderThickness="1" CornerRadius="2" Padding="9">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Transformer" Foreground="#30383D" FontSize="12" FontWeight="SemiBold" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Background="#E5F3E8" BorderBrush="#74B582" BorderThickness="1" CornerRadius="2" Padding="5,2"><TextBlock x:Name="AuthorityBadgeText" Text="LOCAL" Foreground="#35744A" FontSize="8.5" FontWeight="SemiBold" /></Border><Border Margin="5,0,0,0" Background="#E5F3E8" BorderBrush="#74B582" BorderThickness="1" CornerRadius="2" Padding="5,2"><TextBlock x:Name="ModeBadgeText" Text="AUTO" Foreground="#35744A" FontSize="8.5" FontWeight="SemiBold" /></Border></StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Canvas Width="62" Height="250" VerticalAlignment="Top">
                                                    <Line X1="31" Y1="7" X2="31" Y2="235" Stroke="#515B60" StrokeThickness="1.5" />
                                                    <Line X1="12" Y1="7" X2="50" Y2="7" Stroke="#515B60" StrokeThickness="1.5" />
                                                    <Ellipse Width="25" Height="25" Canvas.Left="18.5" Canvas.Top="55" Stroke="#515B60" Fill="#F8F9F9" StrokeThickness="1.4" />
                                                    <Ellipse Width="25" Height="25" Canvas.Left="18.5" Canvas.Top="74" Stroke="#515B60" Fill="#F8F9F9" StrokeThickness="1.4" />
                                                    <Line X1="43" Y1="74" X2="60" Y2="63" Stroke="#2774AE" StrokeThickness="2" />
                                                    <Ellipse Width="8" Height="8" Canvas.Left="27" Canvas.Top="144" Stroke="#515B60" Fill="#FFFFFF" StrokeThickness="1.2" />
                                                    <Line X1="35" Y1="148" X2="58" Y2="148" Stroke="#2774AE" StrokeThickness="2" />
                                                    <Ellipse Width="8" Height="8" Canvas.Left="27" Canvas.Top="194" Stroke="#515B60" Fill="#FFFFFF" StrokeThickness="1.2" />
                                                    <Line X1="12" Y1="235" X2="50" Y2="235" Stroke="#515B60" StrokeThickness="1.5" />
                                                </Canvas>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Tap position" Style="{StaticResource HmiLabel}" />
                                                    <Grid Margin="0,2,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Background="#EEF1F3" BorderBrush="#D0D6DA" BorderThickness="1" Padding="6,2"><TextBlock x:Name="LcdTapText" Text="00" Style="{StaticResource HmiValue}" FontSize="25" HorizontalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock x:Name="LcdPendingTapText" Text="FEEDBACK VALID" Foreground="#697A83" FontSize="7.8" TextWrapping="Wrap" MaxWidth="72" /><TextBlock x:Name="LcdTapRangeText" Text="-08 … +08" Foreground="#697A83" FontFamily="Cascadia Mono, Consolas" FontSize="7.8" /></StackPanel></Grid>
                                                    <TextBlock Text="Voltage" Style="{StaticResource HmiLabel}" />
                                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LcdMeasuredText" Text="0.00" Style="{StaticResource HmiValue}" FontSize="25" /><TextBlock Text=" V" Foreground="#2774AE" FontSize="12" VerticalAlignment="Bottom" Margin="2,0,0,4" /></StackPanel>
                                                    <Grid Margin="0,3,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Setpoint" Style="{StaticResource HmiLabel}" /><TextBlock x:Name="LcdSetpointText" Text="100.00 V" Style="{StaticResource HmiValue}" FontSize="10" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="dU" Style="{StaticResource HmiLabel}" /><TextBlock x:Name="LcdDeviationText" Text="—" Style="{StaticResource HmiValue}" FontSize="10" /></StackPanel></Grid>
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Current" Style="{StaticResource HmiLabel}" /><TextBlock x:Name="LcdCurrentText" Text="I 0.000 A" Style="{StaticResource HmiValue}" FontSize="10" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Power factor" Style="{StaticResource HmiLabel}" /><TextBlock x:Name="LcdPowerText" Text="φ — · PF —" Style="{StaticResource HmiValue}" FontSize="9" /></StackPanel></Grid>
                                                    <TextBlock x:Name="LcdFrequencyText" Text="f — Hz" Foreground="#697A83" FontFamily="Cascadia Mono, Consolas" FontSize="8" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Regulation trend -->
                                    <Border Grid.Column="2" Background="#FAFBFC" BorderBrush="#D4D9DD" BorderThickness="1" CornerRadius="2" Padding="9">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="7" /><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="Independent regulation" Foreground="#30383D" FontSize="12" FontWeight="SemiBold" /><TextBlock x:Name="DeviceStateText" Text="SOURCE OFF" Foreground="#6A7981" FontSize="8.5" Margin="0,2,0,0" /></StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="LcdSourceStateText" Text="SOURCE OFF" Foreground="#2774AE" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock x:Name="LcdOpsText" Text="CMDS 0" Foreground="#697A83" FontFamily="Cascadia Mono, Consolas" FontSize="7.8" HorizontalAlignment="Right" /></StackPanel>
                                            </Grid>
                                            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D8DDE0" BorderThickness="1">
                                                <Grid Margin="7">
                                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="21" /></Grid.RowDefinitions>
                                                    <Canvas x:Name="TrendCanvas" Grid.Row="0" ClipToBounds="True" MinHeight="180" Background="#FCFDFD">
                                                        <Line x:Name="TrendUpperLine" Stroke="#7A858A" StrokeDashArray="4,3" StrokeThickness="1" />
                                                        <Line x:Name="TrendSetpointLine" Stroke="#48805A" StrokeThickness="1.2" />
                                                        <Line x:Name="TrendLowerLine" Stroke="#7A858A" StrokeDashArray="4,3" StrokeThickness="1" />
                                                        <Polyline x:Name="TrendPolyline" Stroke="#287FB5" StrokeThickness="2" StrokeLineJoin="Round" />
                                                        <Ellipse x:Name="TrendValueDot" Width="7" Height="7" Fill="#287FB5" />
                                                    </Canvas>
                                                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="TrendLowerLabel" Text="99.0 V" Foreground="#67747B" FontSize="7.5" /><TextBlock Grid.Column="1" x:Name="TrendSetpointLabel" Text="100.0 V" Foreground="#3E704B" FontSize="7.5" HorizontalAlignment="Center" /><TextBlock Grid.Column="2" x:Name="TrendUpperLabel" Text="101.0 V" Foreground="#67747B" FontSize="7.5" HorizontalAlignment="Right" /></Grid>
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="4">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="5" /><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="Regulation timer" Style="{StaticResource HmiLabel}" /><TextBlock x:Name="LcdBandText" Text="99.00 — 101.00 V" Foreground="#4E636D" FontFamily="Cascadia Mono, Consolas" FontSize="8" /></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="OLTC command / motor" Style="{StaticResource HmiLabel}" /><TextBlock x:Name="LcdCommandText" Text="OUTPUT IDLE" Foreground="#4E636D" FontFamily="Cascadia Mono, Consolas" FontSize="8" TextTrimming="CharacterEllipsis" /></StackPanel>
                                                <ProgressBar Grid.Row="2" x:Name="DelayProgress" Height="7" Minimum="0" Maximum="100" Margin="0,0,4,0" />
                                                <ProgressBar Grid.Row="2" Grid.Column="2" x:Name="MotorProgress" Height="7" Minimum="0" Maximum="100" />
                                                <StackPanel Grid.Row="4" Orientation="Horizontal"><TextBlock x:Name="DelayText" Text="TIMER —" Foreground="#697A83" FontFamily="Cascadia Mono, Consolas" FontSize="7.8" /><TextBlock Text="   ·   " Foreground="#A0AAAF" /><TextBlock x:Name="LcdLimitsText" Text="U 80…120 %" Foreground="#697A83" FontFamily="Cascadia Mono, Consolas" FontSize="7.8" /><TextBlock Text="   ·   " Foreground="#A0AAAF" /><TextBlock x:Name="LcdCurrentLimitsText" Text="I&lt; OFF · I&gt; OFF" Foreground="#697A83" FontFamily="Cascadia Mono, Consolas" FontSize="7.8" /></StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- hidden compatibility tap bar retained for existing renderer -->
                                    <ProgressBar x:Name="TapPositionBar" Visibility="Collapsed" Minimum="-8" Maximum="8" Value="0" />
                                </Grid>

                                <Grid Grid.Row="2" Background="#E9ECEE">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0"><Ellipse x:Name="LocalLed" Width="7" Height="7" Fill="#66C878" Margin="0,0,4,0" /><TextBlock Text="LOCAL" Foreground="#46545B" FontSize="7.8" Margin="0,0,10,0" /><Ellipse x:Name="AutoLed" Width="7" Height="7" Fill="#66C878" Margin="0,0,4,0" /><TextBlock Text="AUTO" Foreground="#46545B" FontSize="7.8" Margin="0,0,10,0" /><Ellipse x:Name="RaiseLed" Width="7" Height="7" Fill="#51606A" Margin="0,0,4,0" /><TextBlock Text="RAISE" Foreground="#46545B" FontSize="7.8" Margin="0,0,10,0" /><Ellipse x:Name="LowerLed" Width="7" Height="7" Fill="#51606A" Margin="0,0,4,0" /><TextBlock Text="LOWER" Foreground="#46545B" FontSize="7.8" /></StackPanel>
                                    <TextBlock Grid.Column="1" x:Name="LcdReasonText" Text="Test source OFF · measurement input de-energized" Foreground="#52626A" FontSize="7.8" Margin="8,0,9,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="270" />
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <Button Style="{StaticResource DeviceButton}" Margin="0,0,0,8" Click="DeviceFunction_Click" Tag="ENTER" Content="ENTER" />
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{StaticResource DeviceButton}" MinHeight="38" Padding="0" Click="DeviceFunction_Click" Tag="LEFT" Content="◀" /><Button Grid.Column="2" Style="{StaticResource DeviceButton}" MinHeight="38" Padding="0" Click="DeviceFunction_Click" Tag="RIGHT" Content="▶" /></Grid>
                            <Button Style="{StaticResource DeviceButton}" Margin="0,0,0,8" Click="DeviceFunction_Click" Tag="BACK" Content="BACK" />
                            <Button Style="{StaticResource DeviceButton}" Click="DeviceFunction_Click" Tag="MENU" Content="MENU" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="ARVREL AVR · BENCH I/O" Foreground="#405058" FontSize="8" FontWeight="SemiBold" /><TextBlock Text="   ·   " Foreground="#75828A" /><TextBlock x:Name="DeviceOutputText" Text="SOURCE OFF" Foreground="#2E3C43" FontFamily="Cascadia Mono, Consolas" FontSize="8" /></StackPanel>
                        <TextBlock Grid.Column="1" Text="SIMULATION ONLY · NO PHYSICAL OLTC AUTHORITY" Foreground="#5D6B72" FontSize="7.6" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Configuration -->
        <Border Grid.Row="1" Grid.Column="4" x:Name="ConfigurationPanel" Background="{StaticResource AvrPanel}" BorderBrush="{StaticResource AvrLine}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid x:Name="ConfigurationExpanded">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Background="#182A38" BorderBrush="{StaticResource AvrLine}" BorderThickness="0,0,0,1" Padding="11,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="AVR CONFIGURATION" Foreground="{StaticResource AvrText}" FontWeight="SemiBold" FontSize="12" /><TextBlock x:Name="ProfileText" Text="ARV-AVR Bench" Foreground="{StaticResource AvrMuted}" FontSize="9" /></StackPanel><Button Grid.Column="1" Style="{StaticResource PanelButton}" Width="30" Height="27" Padding="0" Click="ConfigurePanelToggle_Click" Content="›" /></Grid></Border>
                    <TabControl Grid.Row="1" x:Name="ConfigurationTabs" Background="{StaticResource AvrPanel}" BorderThickness="0">
                        <TabItem Header="General" Style="{StaticResource ConfigTab}"><StackPanel Margin="12"><TextBlock Text="VOLTAGE CONTROL" Style="{StaticResource SectionLabel}" /><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Setpoint (V)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="SetpointBox" Text="100" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Tolerance ± (%)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="ToleranceBox" Text="1" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" /></StackPanel></Grid><TextBlock Text="DEVICE CONTROL" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" /><TextBlock Text="LOCAL / REMOTE is independent from AUTO / MANUAL. REMOTE authority inhibits local mode and direct tap commands." Foreground="{StaticResource AvrMuted}" FontSize="8.8" TextWrapping="Wrap" /></StackPanel></TabItem>
                        <TabItem Header="Time" Style="{StaticResource ConfigTab}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="REGULATION" Style="{StaticResource SectionLabel}" /><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="T1 delay (s)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="T1Box" Text="10" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="T2 fast (s)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="T2Box" Text="2" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" /></StackPanel></Grid><CheckBox x:Name="FastT2Check" Content="Enable fast T2 after completed tap feedback" IsChecked="True" Foreground="{StaticResource AvrText}" Margin="0,10,0,0" /><TextBlock Text="OLTC ACTUATOR" Style="{StaticResource SectionLabel}" Margin="0,16,0,0" /><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Command pulse (s)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="CommandPulseBox" Text="0.5" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Motor travel (s)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="MotorTravelBox" Text="3" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" /></StackPanel></Grid></StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="LDC" Style="{StaticResource ConfigTab}"><StackPanel Margin="12"><TextBlock Text="LINE-DROP COMPENSATION" Style="{StaticResource SectionLabel}" /><CheckBox x:Name="LdcCheck" Content="Enable vendor-neutral compensation" Foreground="{StaticResource AvrText}" Margin="0,8,0,10" /><TextBlock Text="Compensation (%)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="LdcBox" Text="0" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" /><TextBlock Text="Full R/X phasor LDC remains a later model layer." Foreground="{StaticResource AvrMuted}" FontSize="8.8" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel></TabItem>
                        <TabItem Header="Limits" Style="{StaticResource ConfigTab}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="TAP CHANGER" Style="{StaticResource SectionLabel}" /><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Min" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="MinTapBox" Text="-8" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Max" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="MaxTapBox" Text="8" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Step (%)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="TapStepBox" Text="1.25" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" /></StackPanel></Grid><TextBlock Text="VOLTAGE BLOCKING" Style="{StaticResource SectionLabel}" Margin="0,15,0,0" /><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="U&lt; (% Un)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="UnderBlockBox" Text="80" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="U&gt; (% Un)" Foreground="{StaticResource AvrMuted}" FontSize="9" /><TextBox x:Name="OverBlockBox" Text="120" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" /></StackPanel></Grid><TextBlock Text="CURRENT INPUT / BLOCKING" Style="{StaticResource SectionLabel}" Margin="0,15,0,0" /><TextBlock Text="Nominal current In (A secondary)" Foreground="{StaticResource AvrMuted}" FontSize="9" Margin="0,7,0,0" /><TextBox x:Name="NominalCurrentBox" Text="1" Style="{StaticResource DarkTextBox}" Margin="0,3,0,0" /><CheckBox x:Name="UnderCurrentCheck" Content="Enable I&lt; blocking" Foreground="{StaticResource AvrText}" Margin="0,10,0,4" /><TextBox x:Name="UnderCurrentBox" Text="10" Style="{StaticResource DarkTextBox}" ToolTip="I&lt; threshold in % In" /><CheckBox x:Name="OverCurrentCheck" Content="Enable I&gt; blocking" Foreground="{StaticResource AvrText}" Margin="0,10,0,4" /><TextBox x:Name="OverCurrentBox" Text="150" Style="{StaticResource DarkTextBox}" ToolTip="I&gt; threshold in % In" /></StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="Events" Style="{StaticResource ConfigTab}"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="7" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="EVENT TRACE" Style="{StaticResource SectionLabel}" /><TextBlock Grid.Column="1" x:Name="OperationCountText" Text="CMDS 0" Foreground="{StaticResource AvrMuted}" FontFamily="Cascadia Mono, Consolas" FontSize="9" /></Grid><Border Grid.Row="2" Background="#0F1D28" BorderBrush="{StaticResource AvrLine}" BorderThickness="1" CornerRadius="3" Padding="8"><TextBlock x:Name="EventTraceText" Text="READY" Foreground="{StaticResource AvrMuted}" FontFamily="Cascadia Mono, Consolas" FontSize="9" TextWrapping="Wrap" /></Border></Grid></TabItem>
                    </TabControl>
                    <Border Grid.Row="2" Background="#101E29" BorderBrush="{StaticResource AvrLine}" BorderThickness="0,1,0,0" Padding="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{StaticResource PrimaryPanelButton}" Click="ApplySettings_Click" Content="Apply" /><Button Grid.Column="2" Style="{StaticResource PanelButton}" Click="RestoreDefaults_Click" Content="Restore defaults" /></Grid></Border>
                </Grid>
                <Button x:Name="ConfigurationRail" Visibility="Collapsed" Style="{StaticResource PanelButton}" Width="36" Padding="0" Click="ConfigurePanelToggle_Click"><TextBlock Text="CONFIG" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" FontSize="9" FontWeight="SemiBold"><TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform></TextBlock></Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>