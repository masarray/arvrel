<UserControl x:Class="Arvrel.App.Controls.Avr.AvrP0HmiControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="520" MinHeight="420" Background="#F1F3F4">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Ink" Color="#24343C" />
        <SolidColorBrush x:Key="Muted" Color="#6E7D84" />
        <SolidColorBrush x:Key="Blue" Color="#2476AE" />
        <SolidColorBrush x:Key="Green" Color="#2C8B50" />
        <SolidColorBrush x:Key="Line" Color="#D5DBDE" />
        <Style x:Key="TopTab" TargetType="Button">
            <Setter Property="Background" Value="#E5E9EB" />
            <Setter Property="Foreground" Value="#314149" />
            <Setter Property="BorderBrush" Value="#CFD6D9" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="ACTIVE"><Setter TargetName="B" Property="Background" Value="#245D9A" /><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#D7E7F2" /><Setter Property="Foreground" Value="#173B51" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="#EAF6EE" />
            <Setter Property="BorderBrush" Value="#7BC28C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="7,2" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="8.5" /></Style>
        <Style x:Key="Value" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Blue}" /><Setter Property="FontFamily" Value="Cascadia Mono, Consolas" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource Line}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="2" /><Setter Property="Padding" Value="10" /></Style>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Margin" Value="4" /><Setter Property="Padding" Value="12" /></Style>
        <Style x:Key="NetButton" TargetType="Button"><Setter Property="MinHeight" Value="29" /><Setter Property="Padding" Value="10,4" /><Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="#286F9D" /><Setter Property="BorderBrush" Value="#286F9D" /><Setter Property="Cursor" Value="Hand" /></Style>
    </UserControl.Resources>

    <Border Background="#F3F5F6" BorderBrush="#44545B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>

            <!-- Native HMI navigation -->
            <Grid Grid.Row="0" Background="#E5E9EB">
                <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button x:Name="HomeTab" Tag="ACTIVE" Style="{StaticResource TopTab}" Content="HOME" Click="TopTab_Click" />
                <Button Grid.Column="1" x:Name="MeasuredTab" Style="{StaticResource TopTab}" Content="Measured" Click="TopTab_Click" />
                <Button Grid.Column="2" x:Name="ControlTab" Style="{StaticResource TopTab}" Content="Control" Click="TopTab_Click" />
                <Button Grid.Column="3" x:Name="EventsTab" Style="{StaticResource TopTab}" Content="Events" Click="TopTab_Click" />
                <Button Grid.Column="4" x:Name="NetworkTab" Style="{StaticResource TopTab}" Content="Network" Click="TopTab_Click" />
            </Grid>

            <Grid Grid.Row="1" ClipToBounds="True">
                <!-- HOME: operator-first hierarchy. Tap and actual voltage are the hero values. -->
                <Grid x:Name="HomePage" Margin="10,8,10,7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="7" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="7" />
                        <RowDefinition Height="112" />
                        <RowDefinition Height="7" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Badge}"><TextBlock x:Name="HomeAuthority" Text="LOCAL" Foreground="#2C7544" FontSize="9" FontWeight="SemiBold" /></Border>
                            <Border Style="{StaticResource Badge}" Margin="5,0,0,0"><TextBlock x:Name="HomeMode" Text="AUTO" Foreground="#2C7544" FontSize="9" FontWeight="SemiBold" /></Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="HomeState" Text="SOURCE OFF" Foreground="#365B70" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="  ·  " Foreground="#A0AAAF" />
                            <TextBlock x:Name="HomeClock" Text="--:--:--" Foreground="#79868C" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="1.05*" /></Grid.ColumnDefinitions>

                        <!-- OLTC / tap panel -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Canvas Width="70" Height="172" VerticalAlignment="Center">
                                    <Line X1="35" Y1="7" X2="35" Y2="165" Stroke="#556168" StrokeThickness="1.5" />
                                    <Line X1="15" Y1="7" X2="55" Y2="7" Stroke="#556168" StrokeThickness="1.5" />
                                    <Ellipse Width="27" Height="27" Canvas.Left="21.5" Canvas.Top="38" Stroke="#556168" Fill="#FAFBFB" StrokeThickness="1.5" />
                                    <Ellipse Width="27" Height="27" Canvas.Left="21.5" Canvas.Top="59" Stroke="#556168" Fill="#FAFBFB" StrokeThickness="1.5" />
                                    <Line X1="48" Y1="58" X2="67" Y2="45" Stroke="#2476AE" StrokeThickness="2.2" />
                                    <Ellipse Width="8" Height="8" Canvas.Left="31" Canvas.Top="112" Stroke="#556168" Fill="White" StrokeThickness="1.2" />
                                    <Line X1="39" Y1="116" X2="67" Y2="116" Stroke="#2476AE" StrokeThickness="2" />
                                    <Line X1="15" Y1="165" X2="55" Y2="165" Stroke="#556168" StrokeThickness="1.5" />
                                </Canvas>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="TAP POSITION" Foreground="#596A73" FontSize="9" FontWeight="SemiBold" />
                                    <Grid Margin="0,0,0,1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TapHero" Text="00" Style="{StaticResource Value}" FontSize="58" MinWidth="112" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,11,0,0">
                                            <TextBlock x:Name="TapFeedback" Text="FEEDBACK VALID" Foreground="#61737C" FontSize="8.5" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TapRange" Text="-08 … +08" Foreground="#7A888E" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <Canvas x:Name="TapTrackCanvas" Height="23" Margin="0,0,0,1" SizeChanged="TapTrackCanvas_SizeChanged">
                                        <Line x:Name="TapTrackLine" Stroke="#8D989E" StrokeThickness="2" Y1="11" Y2="11" />
                                        <Ellipse x:Name="TapTrackDot" Width="11" Height="11" Fill="#2476AE" />
                                    </Canvas>
                                    <TextBlock Text="OLTC feedback position" Foreground="#8A969C" FontSize="7.7" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Electrical measurements -->
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="7" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ACTUAL VOLTAGE" Style="{StaticResource Caption}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="VoltageHero" Text="0.00" Style="{StaticResource Value}" FontSize="40" />
                                            <TextBlock Text=" V" Foreground="#2476AE" FontSize="13" VerticalAlignment="Bottom" Margin="2,0,0,7" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="SETPOINT" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="HomeSetpoint" Text="100.00 V" Style="{StaticResource Value}" FontSize="12" />
                                        <TextBlock Text="DEVIATION" Style="{StaticResource Caption}" Margin="0,7,0,0" />
                                        <TextBlock x:Name="HomeDeviation" Text="—" Style="{StaticResource Value}" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                                <Separator Grid.Row="2" Background="#E0E4E6" />
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="CURRENT" Style="{StaticResource Caption}" /><TextBlock x:Name="HomeCurrent" Text="0.000 A" Style="{StaticResource Value}" FontSize="12" /></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="POWER FACTOR" Style="{StaticResource Caption}" /><TextBlock x:Name="HomePf" Text="—" Style="{StaticResource Value}" FontSize="12" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="FREQUENCY" Style="{StaticResource Caption}" /><TextBlock x:Name="HomeFreq" Text="— Hz" Style="{StaticResource Value}" FontSize="12" /></StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Compact full-width trend: context, not the hero. -->
                    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="9,7">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="REGULATION TREND" Foreground="#36454D" FontSize="9.5" FontWeight="SemiBold" />
                                <TextBlock x:Name="TrendState" Text="SOURCE OFF" Foreground="#365B70" FontSize="8.5" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock x:Name="CommandCount" Text="CMDS 0" Foreground="#718087" FontFamily="Cascadia Mono, Consolas" FontSize="8" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="#FBFCFC" BorderBrush="#D9DEE1" BorderThickness="1">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="15" /></Grid.RowDefinitions>
                                    <Canvas x:Name="CompactTrendCanvas" ClipToBounds="True" Background="#FBFCFC" SizeChanged="CompactTrendCanvas_SizeChanged">
                                        <Line x:Name="TrendUpper" Stroke="#869299" StrokeDashArray="4,3" />
                                        <Line x:Name="TrendSet" Stroke="#4A8A5A" StrokeThickness="1.2" />
                                        <Line x:Name="TrendLower" Stroke="#869299" StrokeDashArray="4,3" />
                                        <Polyline x:Name="TrendPath" Stroke="#2476AE" StrokeThickness="2" />
                                        <Ellipse x:Name="TrendDot" Width="7" Height="7" Fill="#2476AE" />
                                    </Canvas>
                                    <TextBlock Grid.Row="1" x:Name="TrendScale" Text="99.0     100.0     101.0 V" Foreground="#738087" FontFamily="Cascadia Mono, Consolas" FontSize="7.3" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Text="CONTROL BAND" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="HomeBand" Text="99.00 — 101.00 V" Foreground="#435963" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Margin="0,2,0,0" />
                                <TextBlock Text="OUTPUT" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                <TextBlock x:Name="HomeOutput" Text="IDLE" Foreground="#435963" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Operational strip -->
                    <Border Grid.Row="6" Background="#E8ECEE" BorderBrush="#D4DADC" BorderThickness="1" Padding="9,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.35*" /></Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="T1 / T2 TIMER" Style="{StaticResource Caption}" /><TextBlock Grid.Column="1" x:Name="TimerText" Text="—" Foreground="#4D6069" FontFamily="Cascadia Mono, Consolas" FontSize="8" /></Grid>
                                <ProgressBar Grid.Row="2" x:Name="TimerBar" Height="7" Minimum="0" Maximum="100" />
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="OLTC MOTOR" Style="{StaticResource Caption}" /><TextBlock Grid.Column="1" x:Name="MotorText" Text="READY" Foreground="#4D6069" FontFamily="Cascadia Mono, Consolas" FontSize="8" /></Grid>
                                <ProgressBar Grid.Row="2" x:Name="MotorBar" Height="7" Minimum="0" Maximum="100" />
                            </Grid>
                            <Grid Grid.Column="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="FooterAuthority" Text="LOCAL" Foreground="#3C505A" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="FooterMode" Text="AUTO" Foreground="#3C505A" FontSize="8" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" x:Name="FooterReason" Text="Test source OFF" Foreground="#68767D" FontSize="7.8" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- MEASURED -->
                <Grid x:Name="MeasuredPage" Visibility="Collapsed" Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="MEASURED VALUES" Foreground="#2D3C43" FontSize="12" FontWeight="SemiBold" />
                    <UniformGrid Grid.Row="2" Columns="3" Rows="2">
                        <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="VOLTAGE" Style="{StaticResource Caption}" /><TextBlock x:Name="MeasuredU" Text="0.00 V" Style="{StaticResource Value}" FontSize="25" Margin="0,6,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="CURRENT" Style="{StaticResource Caption}" /><TextBlock x:Name="MeasuredI" Text="0.000 A" Style="{StaticResource Value}" FontSize="25" Margin="0,6,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="TAP POSITION" Style="{StaticResource Caption}" /><TextBlock x:Name="MeasuredTap" Text="00" Style="{StaticResource Value}" FontSize="31" Margin="0,3,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="DEVIATION" Style="{StaticResource Caption}" /><TextBlock x:Name="MeasuredDev" Text="—" Style="{StaticResource Value}" FontSize="21" Margin="0,6,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="POWER / PHASE" Style="{StaticResource Caption}" /><TextBlock x:Name="MeasuredPf" Text="—" Style="{StaticResource Value}" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                        <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="FREQUENCY" Style="{StaticResource Caption}" /><TextBlock x:Name="MeasuredF" Text="— Hz" Style="{StaticResource Value}" FontSize="21" Margin="0,6,0,0" /></StackPanel></Border>
                    </UniformGrid>
                </Grid>

                <!-- CONTROL -->
                <Grid x:Name="ControlPage" Visibility="Collapsed" Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="REGULATION / OLTC CONTROL" Foreground="#2D3C43" FontSize="12" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="IEC 61850 REMOTE authority follows the same interlocks" Foreground="#708087" FontSize="8" /></Grid>
                    <UniformGrid Grid.Row="2" Columns="2" Rows="3">
                        <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="SETPOINT / BAND" Style="{StaticResource Caption}" /><TextBlock x:Name="ControlSetBand" Text="100.00 V · ±1.00 %" Style="{StaticResource Value}" FontSize="18" Margin="0,6,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="TIMERS" Style="{StaticResource Caption}" /><TextBlock x:Name="ControlTimers" Text="T1 10.0s · T2 2.0s" Style="{StaticResource Value}" FontSize="18" Margin="0,6,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="AUTHORITY / MODE" Style="{StaticResource Caption}" /><TextBlock x:Name="ControlAuthority" Text="LOCAL · AUTO" Style="{StaticResource Value}" FontSize="18" Margin="0,6,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="TAP RANGE / STEP" Style="{StaticResource Caption}" /><TextBlock x:Name="ControlTapRange" Text="-08 … +08 · 1.25%" Style="{StaticResource Value}" FontSize="18" Margin="0,6,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="BLOCKING" Style="{StaticResource Caption}" /><TextBlock x:Name="ControlBlocking" Text="U 80…120%" Foreground="#3E5661" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                        <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="SAS PROCESS CONTROL" Style="{StaticResource Caption}" /><TextBlock Text="SBO enhanced · REMOTE required\nAUTO/MANUAL · LTC block · RAISE/LOWER/STOP" Foreground="#3E5661" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                    </UniformGrid>
                </Grid>

                <!-- EVENTS -->
                <Grid x:Name="EventsPage" Visibility="Collapsed" Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="EVENT / CONTROL TRACE" Foreground="#2D3C43" FontSize="12" FontWeight="SemiBold" />
                    <Border Grid.Row="2" Style="{StaticResource Card}" Background="#FCFDFD">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="EventsText" Text="No events" Foreground="#40545E" FontFamily="Cascadia Mono, Consolas" FontSize="9.5" TextWrapping="Wrap" /></ScrollViewer>
                    </Border>
                </Grid>

                <!-- NETWORK -->
                <Grid x:Name="NetworkPage" Visibility="Collapsed" Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="IEC 61850 / MMS" Foreground="#2D3C43" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Commissioning endpoint for IEDScout / SAS" Foreground="#748188" FontSize="8.5" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="NetServerStatus" Text="STOPPED" Foreground="#365B70" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock x:Name="NetServerEndpoint" Text="Bind 0.0.0.0:102" Foreground="#748188" FontFamily="Cascadia Mono, Consolas" FontSize="8" HorizontalAlignment="Right" /></StackPanel></Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="1.0*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="NETWORK ADAPTER" Style="{StaticResource Caption}" /><ComboBox x:Name="AdapterCombo" Height="28" Margin="0,3,0,0" FontSize="9" SelectionChanged="AdapterCombo_SelectionChanged" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="IPv4 ADDRESS" Style="{StaticResource Caption}" /><ComboBox x:Name="Ipv4Combo" Height="28" Margin="0,3,0,0" FontSize="9" SelectionChanged="Ipv4Combo_SelectionChanged" /></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="PORT" Style="{StaticResource Caption}" /><TextBox x:Name="PortBox" Height="28" Text="102" Margin="0,3,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" /></StackPanel>
                            </Grid>
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><CheckBox x:Name="AllInterfacesCheck" Content="Listen on all interfaces (0.0.0.0)" Foreground="#40515A" FontSize="9" Checked="NetworkSelection_Changed" Unchecked="NetworkSelection_Changed" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="StartServerButton" Style="{StaticResource NetButton}" Content="START SERVER" Click="StartServerButton_Click" Margin="0,0,7,0" /><Button x:Name="StopServerButton" Style="{StaticResource NetButton}" Content="STOP" Click="StopServerButton_Click" /></StackPanel></Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="SAS / IEDSCOUT ENDPOINT" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="NetClientEndpoint" Text="&lt;this-PC-IPv4&gt;:102" Style="{StaticResource Value}" FontSize="23" Margin="0,5,0,10" />
                                <TextBlock x:Name="NetAdapterDetails" Text="No active IPv4 adapter detected." Foreground="#4B5E67" FontFamily="Cascadia Mono, Consolas" FontSize="8.8" TextWrapping="Wrap" />
                                <TextBlock x:Name="NetDiagnostics" Text="Select the commissioning LAN adapter, then START SERVER." Foreground="#65757D" FontSize="8.8" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="LIVE MMS DIAGNOSTICS" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="NetCounters" Text="Active 0 · Accepted 0&#x0a;Requests 0 · Reports 0&#x0a;Controls 0/0" Foreground="#40545E" FontFamily="Cascadia Mono, Consolas" FontSize="9.2" Margin="0,6,0,0" />
                                <TextBlock Text="LAST ACTIVITY" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                                <TextBlock x:Name="NetLastActivity" Text="Server stopped" Foreground="#40545E" FontFamily="Cascadia Mono, Consolas" FontSize="8.7" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Hardware MENU overlay -->
                <Border x:Name="MenuOverlay" Visibility="Collapsed" Background="#F0F3F4" BorderBrush="#66757C" BorderThickness="2" Margin="40" Panel.ZIndex="20">
                    <Grid Margin="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="MAIN MENU" Foreground="#283A42" FontSize="14" FontWeight="SemiBold" />
                        <UniformGrid Grid.Row="2" Columns="2" Rows="2">
