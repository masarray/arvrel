<Window x:Class="Arvrel.App.TransformerIedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Arvrel.App.Controls"
        Title="ARVREL — Transformer Differential IED"
        Width="1460"
        Height="860"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource EngineeringValue}">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="TinyValue" TargetType="TextBlock" BasedOn="{StaticResource EngineeringValue}">
            <Setter Property="FontSize" Value="10.3" />
        </Style>
        <Style x:Key="DenseTextBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="DenseCombo" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="#82919C" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="31" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17232D" BorderBrush="#2D3C47" BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" Background="#2E6F9E" CornerRadius="5" Margin="0,0,9,0">
                        <TextBlock Text="87T" Foreground="White" FontWeight="SemiBold" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Transformer Differential IED" Foreground="#F4F7F9" FontSize="14.5" FontWeight="SemiBold" />
                        <TextBlock Text="Two-winding 87T · 87T-HS · REF HV/LV · measured H2/H5" Foreground="#9FB0BC" FontSize="10.2" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="8,4" CornerRadius="4" Background="#203440" BorderBrush="#355262" BorderThickness="1" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RuntimeStatusLed" Style="{StaticResource StatusDot}" Margin="0,0,6,0" />
                            <TextBlock x:Name="RuntimeStatusText" Text="WAITING" Foreground="#B9C7D0" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SourceModeText" Text="SOURCE · IDLE" Foreground="#8395A1" FontFamily="Cascadia Mono, Consolas" FontSize="9.7" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="*" MinWidth="470" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Process-bus inputs" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="Bind exact HV and LV Sampled Values streams" Foreground="{StaticResource MutedBrush}" FontSize="9.8" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource CompactButton}" Content="Refresh" Click="RefreshStreams_Click" />
                        </Grid>

                        <TextBlock Text="HV SV STREAM" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="HvStreamCombo" Style="{StaticResource DenseCombo}" DisplayMemberPath="DisplayName" Margin="0,0,0,7" SelectionChanged="StreamSelection_Changed" />
                        <TextBlock Text="LV SV STREAM" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="LvStreamCombo" Style="{StaticResource DenseCombo}" DisplayMemberPath="DisplayName" Margin="0,0,0,5" SelectionChanged="StreamSelection_Changed" />
                        <TextBlock x:Name="StreamBindingHintText" Text="Select two distinct current streams." Foreground="{StaticResource MutedBrush}" FontSize="9.7" TextWrapping="Wrap" Margin="0,0,0,13" />

                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,11" />
                        <TextBlock Text="Transformer engineering" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,9" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="RATED POWER (MVA)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RatedPowerText" Style="{StaticResource DenseTextBox}" Text="100" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="VECTOR GROUP" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="VectorGroupText" Style="{StaticResource DenseTextBox}" Text="Dyn11" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,0,0">
                                <TextBlock Text="HV RATED kV" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="HvVoltageText" Style="{StaticResource DenseTextBox}" Text="150" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0">
                                <TextBlock Text="LV RATED kV" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="LvVoltageText" Style="{StaticResource DenseTextBox}" Text="20" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="CT SIDE" Style="{StaticResource FieldLabel}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                            <TextBlock Grid.Column="1" Text="PRIMARY A" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="3" Text="SECONDARY A" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Text="HV phase" FontSize="10.3" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="HvCtPrimaryText" Style="{StaticResource DenseTextBox}" Text="600" />
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="HvCtSecondaryText" Style="{StaticResource DenseTextBox}" Text="1" />
                            <TextBlock Grid.Row="2" Text="LV phase" FontSize="10.3" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="LvCtPrimaryText" Style="{StaticResource DenseTextBox}" Text="3000" Margin="0,6,0,0" />
                            <TextBox Grid.Row="2" Grid.Column="3" x:Name="LvCtSecondaryText" Style="{StaticResource DenseTextBox}" Text="1" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Text="HV neutral" FontSize="10.3" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="HvNeutralCtPrimaryText" Style="{StaticResource DenseTextBox}" Text="600" Margin="0,6,0,0" />
                            <TextBox Grid.Row="3" Grid.Column="3" x:Name="HvNeutralCtSecondaryText" Style="{StaticResource DenseTextBox}" Text="1" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="4" Text="LV neutral" FontSize="10.3" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="LvNeutralCtPrimaryText" Style="{StaticResource DenseTextBox}" Text="3000" Margin="0,6,0,0" />
                            <TextBox Grid.Row="4" Grid.Column="3" x:Name="LvNeutralCtSecondaryText" Style="{StaticResource DenseTextBox}" Text="1" Margin="0,6,0,0" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox x:Name="ReverseHvPhaseCheck" Content="Reverse HV phase" FontSize="10.2" Margin="0,0,13,0" />
                            <CheckBox x:Name="ReverseLvPhaseCheck" Content="Reverse LV phase" FontSize="10.2" />
                        </StackPanel>

                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,11" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox x:Name="Enable87TCheck" Content="87T enabled" FontWeight="SemiBold" FontSize="11" Margin="0,0,15,0" Checked="SettingsInput_Changed" Unchecked="SettingsInput_Changed" />
                            <CheckBox x:Name="EnableHighSetCheck" Content="High-set" FontSize="11" Checked="SettingsInput_Changed" Unchecked="SettingsInput_Changed" />
                        </StackPanel>
                        <TextBlock Text="STANDARD DUAL-SLOPE CHARACTERISTIC" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Is1 (pu)" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="Is1Text" Style="{StaticResource DenseTextBox}" Text="0.30" TextChanged="SettingsInput_Changed" />
                                <TextBlock Text="K1 (%)" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                                <TextBox x:Name="K1Text" Style="{StaticResource DenseTextBox}" Text="25" TextChanged="SettingsInput_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Is2 (pu)" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="Is2Text" Style="{StaticResource DenseTextBox}" Text="2.00" TextChanged="SettingsInput_Changed" />
                                <TextBlock Text="K2 (%)" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                                <TextBox x:Name="K2Text" Style="{StaticResource DenseTextBox}" Text="60" TextChanged="SettingsInput_Changed" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="87T DELAY (ms)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="OperateDelayText" Style="{StaticResource DenseTextBox}" Text="20" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="HIGH-SET (pu)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="HighSetText" Style="{StaticResource DenseTextBox}" Text="8.0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="HARMONIC SECURITY" Style="{StaticResource FieldLabel}" Margin="0,9,0,3" />
                        <ComboBox x:Name="HarmonicModeCombo" Style="{StaticResource DenseCombo}" SelectedIndex="1">
                            <ComboBoxItem Content="Disabled" />
                            <ComboBoxItem Content="Blocking" />
                            <ComboBoxItem Content="Restraint" />
                        </ComboBox>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="H2 THRESHOLD (%)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="H2ThresholdText" Style="{StaticResource DenseTextBox}" Text="15" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="H5 THRESHOLD (%)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="H5ThresholdText" Style="{StaticResource DenseTextBox}" Text="35" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox x:Name="EnableHvRefCheck" Content="REF HV" FontSize="10.5" Margin="0,0,13,0" />
                            <CheckBox x:Name="EnableLvRefCheck" Content="REF LV" FontSize="10.5" />
                        </StackPanel>

                        <Button x:Name="ApplyRuntimeButton" Style="{StaticResource PrimaryButton}" Margin="0,13,0,0" Click="ApplyRuntime_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon Kind="ShieldCheck" Width="15" Height="15" Foreground="White" Margin="0,0,6,0" />
                                <TextBlock Text="Apply transformer runtime" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Virtual protection only · no physical trip output" Foreground="{StaticResource MutedBrush}" FontSize="9.3" HorizontalAlignment="Center" Margin="0,5,0,2" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="310" />
                    <RowDefinition Height="9" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="43" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="11,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="87T characteristic" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CharacteristicCaptionText" Text="Is1 0.30 · K1 25% · Is2 2.00 · K2 60%" Foreground="{StaticResource MutedBrush}" FontSize="9.6" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Fill="#3273A8" Width="7" Height="7" Margin="0,0,4,0" /><TextBlock Text="A" FontSize="9.5" Margin="0,0,8,0" />
                                    <Ellipse Fill="#B87E25" Width="7" Height="7" Margin="0,0,4,0" /><TextBlock Text="B" FontSize="9.5" Margin="0,0,8,0" />
                                    <Ellipse Fill="#479157" Width="7" Height="7" Margin="0,0,4,0" /><TextBlock Text="C" FontSize="9.5" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <controls:TransformerDifferentialCharacteristicScope Grid.Row="1" x:Name="CharacteristicScope" Margin="8" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="11,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Differential measurement" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ProtectionDecisionText" Text="  ·  runtime not applied" Foreground="{StaticResource MutedBrush}" FontSize="9.8" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="SettingsFingerprintText" Text="SETTINGS —" Style="{StaticResource TinyValue}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="11,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.35*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="29" /><RowDefinition Height="29" /><RowDefinition Height="29" /></Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Text="Idiff pu" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="2" Text="Ibias pu" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="3" Text="Threshold" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="4" Text="H2" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="5" Text="H5" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="6" Text="State" Style="{StaticResource SectionLabel}" />

                            <TextBlock Grid.Row="1" Text="A" FontWeight="SemiBold" Foreground="#3273A8" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PhaseAIdiffText" Text="—" Style="{StaticResource TinyValue}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="PhaseAIbiasText" Text="—" Style="{StaticResource TinyValue}" />
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="PhaseAThresholdText" Text="—" Style="{StaticResource TinyValue}" />
                            <TextBlock Grid.Row="1" Grid.Column="4" x:Name="PhaseAH2Text" Text="—" Style="{StaticResource TinyValue}" />
                            <TextBlock Grid.Row="1" Grid.Column="5" x:Name="PhaseAH5Text" Text="—" Style="{StaticResource TinyValue}" />
                            <TextBlock Grid.Row="1" Grid.Column="6" x:Name="PhaseAStateText" Text="WAIT" FontSize="9.7" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Text="B" FontWeight="SemiBold" Foreground="#B87E25" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PhaseBIdiffText" Text="—" Style="{StaticResource TinyValue}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="PhaseBIbiasText" Text="—" Style="{StaticResource TinyValue}" />
                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="PhaseBThresholdText" Text="—" Style="{StaticResource TinyValue}" />
                            <TextBlock Grid.Row="2" Grid.Column="4" x:Name="PhaseBH2Text" Text="—" Style="{StaticResource TinyValue}" />
                            <TextBlock Grid.Row="2" Grid.Column="5" x:Name="PhaseBH5Text" Text="—" Style="{StaticResource TinyValue}" />
                            <TextBlock Grid.Row="2" Grid.Column="6" x:Name="PhaseBStateText" Text="WAIT" FontSize="9.7" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="3" Text="C" FontWeight="SemiBold" Foreground="#479157" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PhaseCIdiffText" Text="—" Style="{StaticResource TinyValue}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="PhaseCIbiasText" Text="—" Style="{StaticResource TinyValue}" />
                            <TextBlock Grid.Row="3" Grid.Column="3" x:Name="PhaseCThresholdText" Text="—" Style="{StaticResource TinyValue}" />
                            <TextBlock Grid.Row="3" Grid.Column="4" x:Name="PhaseCH2Text" Text="—" Style="{StaticResource TinyValue}" />
                            <TextBlock Grid.Row="3" Grid.Column="5" x:Name="PhaseCH5Text" Text="—" Style="{StaticResource TinyValue}" />
                            <TextBlock Grid.Row="3" Grid.Column="6" x:Name="PhaseCStateText" Text="WAIT" FontSize="9.7" VerticalAlignment="Center" />
                        </Grid>

                        <Border Grid.Row="2" Background="{StaticResource LineBrush}" />

                        <Grid Grid.Row="3" Margin="11,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="87T" Style="{StaticResource SectionLabel}" /><TextBlock x:Name="RestrainedStateText" Text="DISABLED" Style="{StaticResource MetricValue}" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="87T-HS" Style="{StaticResource SectionLabel}" /><TextBlock x:Name="HighSetStateText" Text="DISABLED" Style="{StaticResource MetricValue}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="REF HV" Style="{StaticResource SectionLabel}" /><TextBlock x:Name="RefHvStateText" Text="DISABLED" Style="{StaticResource MetricValue}" /></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="REF LV" Style="{StaticResource SectionLabel}" /><TextBlock x:Name="RefLvStateText" Text="DISABLED" Style="{StaticResource MetricValue}" /></StackPanel>
                        </Grid>

                        <Border Grid.Row="4" Background="{StaticResource LineBrush}" />

                        <Grid Grid.Row="5" Margin="11,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="HV / LV fundamental current" FontSize="10.6" FontWeight="SemiBold" />
                                <TextBlock x:Name="HvCurrentText" Text="HV  —" Style="{StaticResource TinyValue}" Margin="0,5,0,0" />
                                <TextBlock x:Name="LvCurrentText" Text="LV  —" Style="{StaticResource TinyValue}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="REF operating quantities" FontSize="10.6" FontWeight="SemiBold" />
                                <TextBlock x:Name="RefHvDetailText" Text="HV  —" Style="{StaticResource TinyValue}" Margin="0,5,0,0" />
                                <TextBlock x:Name="RefLvDetailText" Text="LV  —" Style="{StaticResource TinyValue}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="9" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="9" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="11">
                    <StackPanel>
                        <TextBlock Text="Runtime decision" FontSize="12.5" FontWeight="SemiBold" />
                        <Border x:Name="TripStateBadge" Background="#EFF3F5" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="9,7" Margin="0,9,0,0">
                            <StackPanel>
                                <TextBlock x:Name="TripStateText" Text="WAITING FOR RUNTIME" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="TripReasonText" Text="Apply configuration after selecting HV and LV streams." Foreground="{StaticResource MutedBrush}" FontSize="9.7" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource CompactButton}" Click="ResetRuntime_Click">
                                <StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="RotateCcw" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0" /><TextBlock Text="Reset latch" /></StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource CompactButton}" Click="EvaluateNow_Click" Content="Evaluate now" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="11">
                    <StackPanel>
                        <TextBlock Text="SV pairing & trust" FontSize="12.5" FontWeight="SemiBold" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Alignment" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="1" x:Name="PairingCodeText" Text="—" Style="{StaticResource TinyValue}" TextAlignment="Right" />
                            <TextBlock Grid.Row="1" Text="smpCnt" Style="{StaticResource SectionLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PairCounterText" Text="—" Style="{StaticResource TinyValue}" TextAlignment="Right" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Text="smpSynch" Style="{StaticResource SectionLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PairSyncText" Text="—" Style="{StaticResource TinyValue}" TextAlignment="Right" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Text="Correction" Style="{StaticResource SectionLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PairCorrectionText" Text="—" Style="{StaticResource TinyValue}" TextAlignment="Right" Margin="0,6,0,0" />
                        </Grid>
                        <TextBlock x:Name="PairingDetailText" Text="No aligned pair yet." Foreground="{StaticResource MutedBrush}" FontSize="9.5" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="11,0">
                            <TextBlock Text="Engineering evidence" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="11">
                                <TextBlock Text="TRANSFORMER" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="EngineeringSummaryText" Text="Not applied" FontSize="10.2" TextWrapping="Wrap" Margin="0,3,0,9" />
                                <TextBlock Text="COMPENSATION" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="CompensationText" Text="—" Style="{StaticResource TinyValue}" TextWrapping="Wrap" Margin="0,3,0,9" />
                                <TextBlock Text="HARMONIC EVIDENCE" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="HarmonicEvidenceText" Text="—" Style="{StaticResource TinyValue}" TextWrapping="Wrap" Margin="0,3,0,9" />
                                <TextBlock Text="PAIR IDENTITY" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="PairIdentityText" Text="—" Style="{StaticResource TinyValue}" TextWrapping="Wrap" Margin="0,3,0,9" />
                                <TextBlock Text="SOURCE" Style="{StaticResource SectionLabel}" />
                                <TextBlock x:Name="SourceEvidenceText" Text="—" Style="{StaticResource TinyValue}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="2" Style="{StaticResource LeanButton}" Margin="11,5,11,11" Click="ExportEvidence_Click">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon Kind="Download" Width="15" Height="15" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Export transformer evidence JSON" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="11,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Select two SV streams and apply transformer runtime settings." Foreground="{StaticResource MutedBrush}" FontSize="9.8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="P12 PRACTITIONER UI · VIRTUAL PROTECTION" Foreground="#8998A2" FontFamily="Cascadia Mono, Consolas" FontSize="9.2" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
