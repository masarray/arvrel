<Window x:Class="Arvrel.App.MeasurementContextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Arvrel.App.Controls"
        Title="ARVREL Measurement Context"
        Width="470"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="CT, VT and timebase context" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Protection operates in secondary amperes and volts. Primary view applies CT and VT ratios only to engineering display and evidence." Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,12" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="CT primary current" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="PrimaryText" VerticalContentAlignment="Center" />
                <TextBlock Grid.Row="1" Text="CT secondary current" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SecondaryText" VerticalContentAlignment="Center" />
                <TextBlock Grid.Row="2" Text="VT primary voltage" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="VoltagePrimaryText" VerticalContentAlignment="Center" />
                <TextBlock Grid.Row="3" Text="VT secondary voltage" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="VoltageSecondaryText" VerticalContentAlignment="Center" />
                <TextBlock Grid.Row="4" Text="Nominal frequency" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="FrequencyText" VerticalContentAlignment="Center" />
                <Border Grid.Row="5" Grid.ColumnSpan="2" Background="#F5F8FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                    <TextBlock x:Name="RatioText" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText" Foreground="{StaticResource TripBrush}" FontSize="10.5" VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource LeanButton}" Margin="0,0,6,0" IsCancel="True">
                    <StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="X" Width="15" Height="15" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,6,0" /><TextBlock Text="Cancel" /></StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="Apply_Click">
                    <StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="Save" Width="15" Height="15" Foreground="White" Margin="0,0,6,0" /><TextBlock Text="Apply context" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
