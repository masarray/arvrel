<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>beta.1</VersionSuffix>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-beta.1</InformationalVersion>

    <Authors>Ari Sulistiono</Authors>
    <Company>masarray</Company>
    <Product>ARVREL — Virtual Protection Relay Laboratory</Product>
    <Description>Vendor-neutral IEC 61850 Sampled Values virtual protection relay laboratory for Windows.</Description>
    <Copyright>Copyright (C) 2026 Ari Sulistiono</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/masarray/arvrel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/masarray/arvrel</PackageProjectUrl>
    <PackageTags>iec61850;sampled-values;smv;protection-relay;process-bus;power-systems</PackageTags>

    <!-- Expected source-development layout:
         Git/ARIEC61850
         Git/arvrel
         Public release artifacts bundle the compiled sibling dependency.
    -->
    <ARIEC61850Root Condition="'$(ARIEC61850Root)' == ''">$(MSBuildThisFileDirectory)..\ARIEC61850</ARIEC61850Root>
    <HasARIEC61850Sibling Condition="Exists('$(ARIEC61850Root)\src\AR.Iec61850\AR.Iec61850.csproj')">true</HasARIEC61850Sibling>
    <HasARIEC61850Sibling Condition="'$(HasARIEC61850Sibling)' == ''">false</HasARIEC61850Sibling>
  </PropertyGroup>
</Project>
